+// SPDX-FileCopyrightText: Copyright 2026 NEXUS
+// SPDX-License-Identifier: GPL-3.0-or-later
+
+#pragma once
+
+#include <filesystem>
+
+#include "common/fs/fs_paths.h"
+#include "common/fs/path_util.h"
+
+namespace Common::FS {
+
+/// NEXUS shared shader cache. NEXUS can point EdenPath::ShaderDir at a folder shared by every
+/// NEXUS user on the PC (the session's "shaderDir"). That folder holds only data that is the same
+/// on any GPU: the shader cache v2 log (guest programs and pipeline keys, its own file lock for
+/// appends) and the precache files. What belongs to this user's GPU and driver stays in the
+/// user's own cache folder, returned here: the driver blobs, the Vulkan pipeline cache, the boot
+/// marker and the precache's "done" marker and progress, whose meaning is "the driver's cache of
+/// this user has these programs" (the GPU driver keeps its cache per Windows user).
+/// Without a shared folder both are the same folder, as before.
+[[nodiscard]] inline std::filesystem::path DeviceShaderDir() {
+    return GetEdenPath(EdenPath::CacheDir) / SHADER_DIR;
+}
+
+/// True when the portable shader data is in a shared folder.
+[[nodiscard]] inline bool SharedShaderCache() {
+    return GetEdenPath(EdenPath::ShaderDir) != DeviceShaderDir();
+}
+
+} // namespace Common::FS
