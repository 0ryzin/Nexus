+    // Another NEXUS user preparing the same game in the shared folder: wait for it, then use its
+    // file (current by then) instead of writing the same file at the same time.
+    std::error_code dir_ec;
+    std::filesystem::create_directories(path.parent_path(), dir_ec);
+    auto lock_path = path;
+    lock_path += ".lock";
+    std::optional<Common::FS::FileLock> prep_lock;
+    prep_lock.emplace(lock_path);
+    if (prep_lock->Busy()) {
+        LOG_INFO(Frontend, "NEXUS Engine: another NEXUS is preparing these shaders; waiting");
+        {
+            std::scoped_lock lk{e.mutex};
+            e.prep_stage = "Waiting for another NEXUS user";
+        }
+        prep_lock.reset();
+        prep_lock.emplace(lock_path, std::chrono::hours{2}, stop);
+        if (stop.stop_requested()) {
+            finish(PrepStopped, {});
+            return;
+        }
+    }
