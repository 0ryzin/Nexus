+// NEXUS shared shader cache: the portable shader data in the folder NEXUS shares between its
+// users (nexus_shared_cache.h); the rest stays in this user's data folder.
+void UseSharedShaderDir(const std::string& dir) {
+    if (dir.empty()) {
+        return;
+    }
+    std::error_code ec;
+    const auto path = std::filesystem::path(Common::FS::ToU8String(dir));
+    std::filesystem::create_directories(path, ec);
+    if (!ec && Common::FS::IsDir(path)) {
+        Common::FS::SetEdenPath(Common::FS::EdenPath::ShaderDir, path);
+    }
+}
