+// NEXUS shared shader cache: the precache file is shared, what says "this user's driver cache has
+// it" is not.
+TEST_CASE("ShaderPrecache: in a shared folder the marker and progress stay with the user",
+          "[video_core]") {
+    TempDir dir;
+    const auto shared = dir.path / "shared";
+    const auto user = dir.path / "user";
+    std::filesystem::create_directories(shared / "0400486024dec000");
+    std::filesystem::create_directories(user / "shader");
+    using Common::FS::EdenPath;
+    const auto old_cache = Common::FS::GetEdenPath(EdenPath::CacheDir);
+    const auto old_shader = Common::FS::GetEdenPath(EdenPath::ShaderDir);
+    Common::FS::SetEdenPath(EdenPath::CacheDir, user);
+    Common::FS::SetEdenPath(EdenPath::ShaderDir, shared);
+    const auto warm = shared / "0400486024dec000" / "warm-compute.bin";
+    const bool is_shared = Common::FS::SharedShaderCache();
+    const auto marker = ShaderWarm::WarmMarkerPath(warm);
+    const auto progress = ShaderWarm::WarmProgressPath(warm);
+    const auto outside = ShaderWarm::WarmMarkerPath(dir.path / "elsewhere" / "warm-compute.bin");
+    Common::FS::SetEdenPath(EdenPath::ShaderDir, user / "shader");
+    const bool not_shared = !Common::FS::SharedShaderCache();
+    Common::FS::SetEdenPath(EdenPath::CacheDir, old_cache);
+    Common::FS::SetEdenPath(EdenPath::ShaderDir, old_shader);
+    REQUIRE(is_shared);
+    REQUIRE(not_shared);
+    REQUIRE(marker == user / "shader" / "0400486024dec000" / "warm-compute.done");
+    REQUIRE(progress == user / "shader" / "0400486024dec000" / "warm-compute.partial");
+    REQUIRE(outside == dir.path / "elsewhere" / "warm-compute.done");
+}
