+namespace {
+/// NEXUS: a file about this user's driver cache that goes with a precache file. Next to it,
+/// unless the precache file is in a shared shader folder: then in the user's own folder, under
+/// the same title (nexus_shared_cache.h).
+fs::path DeviceSidecar(const fs::path& warm_file, const char* extension) {
+    fs::path path = warm_file;
+    path.replace_extension(extension);
+    if (Common::FS::SharedShaderCache() &&
+        warm_file.parent_path().parent_path() ==
+            Common::FS::GetEdenPath(Common::FS::EdenPath::ShaderDir)) {
+        const fs::path dir = Common::FS::DeviceShaderDir() / warm_file.parent_path().filename();
+        std::error_code ignored;
+        fs::create_directories(dir, ignored);
+        return dir / path.filename();
+    }
+    return path;
+}
+} // Anonymous namespace
+
 fs::path WarmMarkerPath(const fs::path& warm_file) {
-    fs::path marker = warm_file;
-    marker.replace_extension(".done");
-    return marker;
+    return DeviceSidecar(warm_file, ".done");
 }
 
