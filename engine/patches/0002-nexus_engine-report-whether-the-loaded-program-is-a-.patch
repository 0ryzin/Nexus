From 8a38324b67d07b4fc825bf9dcf577335d5ce4967 Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Tue, 10 Nov 2026 23:33:55 +0000
Subject: [PATCH 02/21] nexus_engine: report whether the loaded program is a
 Switch 1 or Switch 2 (NPDM) program

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01X7yw1ZJY9GYi2KYHfiXxvY
(cherry picked from commit e67bac0af2fab3178f4d8e1651bf2d31b0f5176a)
---
 src/nexus_engine/nexus_engine.cpp | 9 +++++++++
 1 file changed, 9 insertions(+)

diff --git a/src/nexus_engine/nexus_engine.cpp b/src/nexus_engine/nexus_engine.cpp
index 9d420e8d7..0b3fd1697 100644
--- a/src/nexus_engine/nexus_engine.cpp
+++ b/src/nexus_engine/nexus_engine.cpp
@@ -31,6 +31,7 @@
 #include "core/cpu_manager.h"
 #include "core/file_sys/registered_cache.h"
 #include "core/file_sys/vfs/vfs_real.h"
+#include "core/hle/kernel/k_process.h"
 #include "core/hle/service/am/applet_manager.h"
 #include "core/hle/service/filesystem/filesystem.h"
 #include "core/loader/loader.h"
@@ -94,6 +95,7 @@ struct Engine {
     std::atomic<int> volume{100};
     std::atomic<std::uint64_t> frames{0};
     std::atomic<std::uint64_t> program_id{0};
+    std::atomic<int> system_gen{0}; // 1 = Switch 1 program, 2 = Switch 2 program (NPDM ACID layout)
     std::string code;    // guarded by mutex
     std::string message; // guarded by mutex
     std::string info_json;
@@ -186,6 +188,7 @@ void RunSession(Request req) {
     Engine& e = E();
     e.frames = 0;
     e.program_id = 0;
+    e.system_gen = 0;
 
     // All engine data lives in the folder NEXUS chose (keys, firmware, NAND, saves, caches).
     Common::FS::SetAppDirectory(req.data_dir);
@@ -239,6 +242,9 @@ void RunSession(Request req) {
             return;
         }
         e.program_id = system.GetApplicationProcessProgramID();
+        if (const auto* proc = system.ApplicationProcess()) {
+            e.system_gen = proc->IsSwitch2() ? 2 : 1;
+        }
 
         system.GPU().Start();
         system.GetCpuManager().OnGpuReady();
@@ -393,6 +399,9 @@ NEXUS_API int32_t nexus_engine_status(char* buf, int32_t buf_len) {
         std::snprintf(hex, sizeof(hex), "%016llX", static_cast<unsigned long long>(id));
         j["programId"] = hex;
     }
+    if (const int gen = e.system_gen.load(); gen != 0) {
+        j["system"] = gen == 2 ? "switch2" : "switch1";
+    }
     {
         std::scoped_lock lk{e.mutex};
         if (!e.code.empty()) {
