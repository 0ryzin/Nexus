@@ -91,3 +93,39 @@ TEST_CASE("Host RAM takes udev's total only when it covers managed memory", "[co
     CHECK(none.bytes == 15_GiB);
     CHECK_FALSE(none.installed);
 }
+
+TEST_CASE("Linux commit room: default overcommit uses available RAM and free swap", "[common]") {
+    // Steam Deck-like: 16 GB shared memory, zram swap.
+    const auto info = Common::ParseLinuxMeminfo("MemTotal:       15950000 kB\n"
+                                                "MemFree:         1000000 kB\n"
+                                                "MemAvailable:    4194304 kB\n"
+                                                "SwapTotal:       8388608 kB\n"
+                                                "SwapFree:        2097152 kB\n"
+                                                "CommitLimit:    16363608 kB\n"
+                                                "Committed_AS:   30000000 kB\n");
+    CHECK(info.mem_available == 4_GiB);
+    CHECK(info.swap_free == 2_GiB);
+    CHECK(Common::LinuxCommitRoom(info, false) == 6_GiB);
+    // Strict mode follows CommitLimit like Windows, and never goes negative.
+    CHECK(Common::LinuxCommitRoom(info, true) == 0);
+}
+
+TEST_CASE("Linux commit room: strict overcommit and missing fields", "[common]") {
+    const auto strict = Common::ParseLinuxMeminfo("CommitLimit: 8388608 kB\nCommitted_AS: 4194304 kB");
+    CHECK(Common::LinuxCommitRoom(strict, true) == 4_GiB);
+    CHECK_FALSE(Common::LinuxCommitRoom(strict, false).has_value()); // no MemAvailable
+    CHECK_FALSE(Common::LinuxCommitRoom(Common::ParseLinuxMeminfo(""), false).has_value());
+    const auto no_swap = Common::ParseLinuxMeminfo("garbage line\nMemAvailable:\t1048576 kB\n");
+    CHECK(Common::LinuxCommitRoom(no_swap, false) == 1_GiB);
+    CHECK_FALSE(Common::ParseLinuxMeminfo("MemAvailable: x kB\n").mem_available.has_value());
+}
+
+TEST_CASE("Host cap on the texture cache: Switch 2 game on a 16 GB handheld", "[common]") {
+    // With 3 GiB of device memory in use and 4 GiB of RAM+swap still available, the cache may
+    // hold 5 GiB (2 GiB stays for the rest of the system), never less than the 3 GiB a scene needs.
+    const auto room = Common::LinuxCommitRoom(
+        Common::ParseLinuxMeminfo("MemAvailable: 3145728 kB\nSwapFree: 1048576 kB\n"), false);
+    REQUIRE(room.has_value());
+    CHECK(VideoCommon::HostCriticalMemory(3_GiB, *room) == 5_GiB);
+    CHECK(VideoCommon::HostCriticalMemory(1_GiB, 0) == VideoCommon::MinHostCriticalMemory);
+}
