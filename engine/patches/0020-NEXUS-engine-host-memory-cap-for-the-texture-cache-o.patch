@@ -25,7 +25,9 @@
 #include <fstream>
 #include <iterator>
 #include <string>
+#include <iterator>
 #include <string_view>
+#include "common/linux_commit_room.h"
 #endif
 
 #include <atomic>
@@ -229,6 +231,17 @@ std::optional<u64> GetSystemCommitRoom() {
         const u64 committed = performance.CommitTotal;
         return (committed < limit ? limit - committed : 0) * performance.PageSize;
     }
+#elif defined(__linux__)
+    std::ifstream meminfo("/proc/meminfo");
+    if (!meminfo) {
+        return std::nullopt;
+    }
+    const std::string text{std::istreambuf_iterator<char>(meminfo), {}};
+    int overcommit = 0;
+    if (std::ifstream mode("/proc/sys/vm/overcommit_memory"); mode) {
+        mode >> overcommit;
+    }
+    return LinuxCommitRoom(ParseLinuxMeminfo(text), overcommit == 2);
 #endif
     return std::nullopt;
 }
