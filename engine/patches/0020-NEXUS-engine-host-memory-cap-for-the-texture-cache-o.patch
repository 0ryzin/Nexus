+++ b/src/common/linux_commit_room.h
@@ -0,0 +1,86 @@
+// SPDX-FileCopyrightText: 2026 NEXUS project
+// SPDX-License-Identifier: GPL-3.0-or-later
+
+// The Linux side of Common::GetSystemCommitRoom (memory_detect.h). The texture cache uses that
+// room to cap how much device memory it holds before collecting (HostCriticalMemory in
+// video_core/texture_cache/host_memory_limit.h). Until NEXUS added this, Linux reported no
+// room at all and the cap was off there: on a handheld with 16 GB of memory shared by the CPU
+// and the GPU (Steam Deck, ROG Ally X under Linux) a Switch 2 game's 12 GiB of guest memory and
+// the texture cache compete for the same RAM, and the kernel's out-of-memory killer ends the
+// session instead of the driver refusing an allocation.
+//
+// Idea credited to Fritchii's texture-cache ceiling (a fixed 7680 MiB cap, see NEXUS
+// docs/research/FRITCHII.md); NEXUS instead feeds the host's real room into the cap Lichii
+// already has, so it follows other programs' use and is not a fixed number.
+
+#pragma once
+
+#include <charconv>
+#include <optional>
+#include <string_view>
+
+#include "common/common_types.h"
+
+namespace Common {
+
+/// The fields of /proc/meminfo that decide how much more memory the kernel will hand out.
+struct LinuxMeminfo {
+    std::optional<u64> mem_available; ///< MemAvailable (bytes)
+    std::optional<u64> swap_free;     ///< SwapFree (bytes)
+    std::optional<u64> commit_limit;  ///< CommitLimit (bytes)
+    std::optional<u64> committed_as;  ///< Committed_AS (bytes)
+};
+
+/// Parses the text of /proc/meminfo ("Name:   12345 kB" lines). Unknown lines are skipped.
+[[nodiscard]] inline LinuxMeminfo ParseLinuxMeminfo(std::string_view text) {
+    LinuxMeminfo info;
+    while (!text.empty()) {
+        const size_t end = text.find('\n');
+        std::string_view line = text.substr(0, end);
+        text = end == std::string_view::npos ? std::string_view{} : text.substr(end + 1);
+        const size_t colon = line.find(':');
+        if (colon == std::string_view::npos) {
+            continue;
+        }
+        const std::string_view name = line.substr(0, colon);
+        std::optional<u64>* field = name == "MemAvailable"   ? &info.mem_available
+                                    : name == "SwapFree"     ? &info.swap_free
+                                    : name == "CommitLimit"  ? &info.commit_limit
+                                    : name == "Committed_AS" ? &info.committed_as
+                                                             : nullptr;
+        if (field == nullptr) {
+            continue;
+        }
+        std::string_view value = line.substr(colon + 1);
+        while (!value.empty() && (value.front() == ' ' || value.front() == '\t')) {
+            value.remove_prefix(1);
+        }
+        u64 kib = 0;
+        const auto [ptr, ec] = std::from_chars(value.data(), value.data() + value.size(), kib);
+        if (ec != std::errc{} || kib > (~u64{0} >> 10)) {
+            continue;
+        }
+        *field = kib << 10;
+    }
+    return info;
+}
+
+/// The memory the kernel can still hand out, in bytes, the way Windows' commit room is used.
+/// strict_overcommit: vm.overcommit_memory is 2, so the kernel refuses allocations past
+/// CommitLimit just like Windows; the room is CommitLimit - Committed_AS. Otherwise (the default
+/// heuristic mode, SteamOS included) allocations succeed until RAM and swap run out and then the
+/// OOM killer picks a process, so the room is what is still available: MemAvailable + SwapFree.
+/// No value when /proc/meminfo lacks the fields (very old kernels).
+[[nodiscard]] inline std::optional<u64> LinuxCommitRoom(const LinuxMeminfo& info,
+                                                        bool strict_overcommit) {
+    if (strict_overcommit && info.commit_limit && info.committed_as) {
+        return *info.committed_as < *info.commit_limit ? *info.commit_limit - *info.committed_as
+                                                       : u64{0};
+    }
+    if (!info.mem_available) {
+        return std::nullopt;
+    }
+    return *info.mem_available + info.swap_free.value_or(0);
+}
+
+} // namespace Common
