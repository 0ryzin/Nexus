From d1fe68e2551b755357713a100908ecbeb7fdc0a4 Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Tue, 17 Nov 2026 18:22:23 +0000
Subject: [PATCH 29/30] package_engine: ship the engine's symbol table with the
 DLL it was made for

nexus_engine.symbols.gz (made by NEXUS's make_symbols.py from the link map) is packaged next to
nexus_engine.dll and hashed in engine.json, after checking that its first line names this DLL's
SHA-256. NEXUS_REQUIRE_SYMBOLS makes a missing table an error (CI).

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01X7yw1ZJY9GYi2KYHfiXxvY
---
 tools/nexus/package_engine.py | 17 +++++++++++++++++
 1 file changed, 17 insertions(+)

diff --git a/tools/nexus/package_engine.py b/tools/nexus/package_engine.py
index ea2885b18..57c8cd8d9 100644
--- a/tools/nexus/package_engine.py
+++ b/tools/nexus/package_engine.py
@@ -2,6 +2,9 @@
 
     nexus_engine.dll            the engine
     engine.json                 version, interface, source commit, upstream base, SHA-256 of every file
+    nexus_engine.symbols.gz     the engine's functions by address, made from this DLL's link map
+                                (NEXUS's tools/release/make_symbols.py): NEXUS names the engine
+                                frames of a crash with it
     Libraries\\*.dll             every other DLL the build produced (SDL3, FFmpeg, ...)
     Libraries\\vcruntime140*.dll Microsoft Visual C++ runtime, app-local copies (permitted by the
     Libraries\\msvcp140*.dll     Visual Studio redistribution terms), so users need not install it
@@ -18,6 +21,20 @@ os.makedirs(out, exist_ok=True)
 version = os.environ.get("GITHUB_REF_NAME", "dev").replace("engine-v", "").replace("/", "-")
 
 files = {"nexus_engine.dll": os.path.join(src, "nexus_engine.dll")}
+# the symbol table of exactly this DLL (its first line names the DLL's SHA-256); required when
+# NEXUS_REQUIRE_SYMBOLS is set (CI), so a release never ships without it
+symbols = os.path.join(src, "nexus_engine.symbols.gz")
+if os.path.exists(symbols):
+    import gzip
+    with open(files["nexus_engine.dll"], "rb") as fh:
+        dll_sha = hashlib.sha256(fh.read()).hexdigest()
+    with gzip.open(symbols, "rt", encoding="utf-8") as fh:
+        head = fh.readline().split()
+    if len(head) != 5 or head[0] != "NEXUSSYM" or head[2] != dll_sha:
+        sys.exit(f"{symbols} is not the symbol table of this nexus_engine.dll ({head[:3]})")
+    files["nexus_engine.symbols.gz"] = symbols
+elif os.environ.get("NEXUS_REQUIRE_SYMBOLS"):
+    sys.exit(f"{symbols} is missing (NEXUS_REQUIRE_SYMBOLS)")
 for f in sorted(os.listdir(src)):
     if f.lower().endswith(".dll") and f != "nexus_engine.dll":
         files["Libraries/" + f] = os.path.join(src, f)
