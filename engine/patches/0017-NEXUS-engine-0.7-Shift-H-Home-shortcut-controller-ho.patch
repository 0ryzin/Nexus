From 403bc888bc26e846908c0461ed258745d0aba592 Mon Sep 17 00:00:00 2001
From: NEXUS <nexus@users.noreply.github.com>
Date: Thu, 12 Nov 2026 21:19:58 +0000
Subject: [PATCH 17/22] NEXUS engine 0.7: Shift+H Home shortcut, controller
 hot-plug, keyboard focus for the embedded game

- The Home shortcut may have modifiers (default Shift+H): plain H stays the game's.
- Controllers connected or disconnected during a game are mapped at once (player 1 goes back to
  the keyboard layout when none is left); Home/capture stay reserved.
- While the game is in front inside the NEXUS window, it keeps the keyboard focus (clicks on a
  child window and full-screen changes no longer leave it with the NEXUS interface).

(cherry picked from commit a13dbdbfd9c35545adedb9c71991204ea118ac58)
---
 src/nexus_engine/nexus_engine.cpp | 67 ++++++++++++++++++++++++++++---
 1 file changed, 62 insertions(+), 5 deletions(-)

diff --git a/src/nexus_engine/nexus_engine.cpp b/src/nexus_engine/nexus_engine.cpp
index e69d24d7a..dabf4c6f2 100644
--- a/src/nexus_engine/nexus_engine.cpp
+++ b/src/nexus_engine/nexus_engine.cpp
@@ -306,6 +306,24 @@ void ShowEmbedded(SDL_Window* window) {
     SetFocus(hwnd);
 }
 
+/// Gives the embedded game the keyboard while the NEXUS window is the active window.
+void KeepEmbeddedFocus(SDL_Window* window) {
+    HWND hwnd = GameHwnd(window);
+    if (hwnd == nullptr || !IsWindowVisible(hwnd)) {
+        return;
+    }
+    HWND root = GetAncestor(hwnd, GA_ROOT);
+    if (root == nullptr || GetForegroundWindow() != root) {
+        return;
+    }
+    GUITHREADINFO gi{};
+    gi.cbSize = sizeof(gi);
+    if (GetGUIThreadInfo(GetWindowThreadProcessId(root, nullptr), &gi) && gi.hwndFocus != hwnd &&
+        gi.hwndCapture == nullptr) {
+        SetFocus(hwnd); // the queues are attached (child window), so this works across threads
+    }
+}
+
 /// Keeps the embedded game the size of the NEXUS window's client area.
 void SyncEmbeddedSize(SDL_Window* window) {
     HWND hwnd = GameHwnd(window);
@@ -824,6 +842,8 @@ void RunSession(Request req) {
