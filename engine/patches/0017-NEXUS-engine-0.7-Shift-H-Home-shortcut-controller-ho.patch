+        e.home_key_conflict = home_sc.key != SDL_SCANCODE_UNKNOWN && !home_key_usable;
         if (e.home_key_conflict) {
             LOG_WARNING(Frontend, "NEXUS Engine: the Home key {} is a game control; it goes to the game",
                         req.home_key);
@@ -926,6 +948,11 @@ void RunSession(Request req) {
         auto fade_start = std::chrono::steady_clock::time_point{};
