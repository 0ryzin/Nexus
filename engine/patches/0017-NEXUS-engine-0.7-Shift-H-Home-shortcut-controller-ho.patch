+        // controller hot-plug: a connect/disconnect is handled shortly after (the input layer
+        // registers the device from the same event first)
+        auto remap_at = std::chrono::steady_clock::time_point{};
+        auto last_focus_check = std::chrono::steady_clock::time_point{};
+
         // Event loop: input, window events, live volume, stop requests.
         int applied_volume = e.volume.load();
         while (!e.stop_requested && window->IsOpen()) {
@@ -937,7 +964,7 @@ void RunSession(Request req) {
                     const bool pad = event.type == SDL_EVENT_GAMEPAD_BUTTON_DOWN ||
                                      event.type == SDL_EVENT_GAMEPAD_BUTTON_UP;
                     const bool pad_down = event.type == SDL_EVENT_GAMEPAD_BUTTON_DOWN;
-                    if (key && home_key_usable && event.key.scancode == home_key) {
+                    if (key && home_key_usable && home_sc.Matches(event.key)) {
                         if (key_down) {
                             home_press();
                         }
@@ -975,9 +1002,39 @@ void RunSession(Request req) {
                         continue;
                     }
                     window->OnEvent(event);
+                    if (req.auto_map_controller &&
+                        (event.type == SDL_EVENT_GAMEPAD_ADDED || event.type == SDL_EVENT_GAMEPAD_REMOVED)) {
+                        remap_at = std::chrono::steady_clock::now() + std::chrono::milliseconds(400);
+                    }
                 } while (SDL_PollEvent(&event));
             }
             const auto now = std::chrono::steady_clock::now();
+            if (remap_at != std::chrono::steady_clock::time_point{} && now >= remap_at) {
+                remap_at = {};
+                const auto devices = input.GetInputDevices();
+                const bool any_pad = std::any_of(devices.begin(), devices.end(), [](const auto& d) {
+                    const auto engine = d.Get("engine", "");
