+                } else {
+                    Settings::values.players.GetValue()[0] = keyboard_player;
+                    Settings::values.players.GetValue()[0].connected = true;
+                    system.HIDCore().ReloadInputDevices();
+                    LOG_INFO(Frontend, "NEXUS: no controller left, player 1 uses the keyboard again");
+                }
+                ReserveSystemButtons(system, req.home_button, req.capture_button);
+            }
+#ifdef _WIN32
+            // keyboard focus for the game drawn inside the NEXUS window: a click on a child window
+            // does not move the keyboard to it, and full-screen changes of the NEXUS window give
+            // it to the NEXUS interface; while the game is in front, it belongs to the game
+            if (e.embedded && e.shown && !e.suspended && now - last_focus_check > std::chrono::milliseconds(150)) {
+                last_focus_check = now;
+                KeepEmbeddedFocus(window->GetSDLWindow());
+            }
