         if (req.auto_map_controller) {
             AutoMapController(input, system, req.button_map, req.controller_type, req.controllers);
         }
@@ -891,10 +911,12 @@ void RunSession(Request req) {
             const SDL_Scancode k = name.empty() ? SDL_SCANCODE_UNKNOWN : SDL_GetScancodeFromName(name.c_str());
             return k != SDL_SCANCODE_UNKNOWN && !KeyUsedByGameControls(k) ? k : SDL_SCANCODE_UNKNOWN;
         };
-        const SDL_Scancode home_key =
-            req.home_key.empty() ? SDL_SCANCODE_UNKNOWN : SDL_GetScancodeFromName(req.home_key.c_str());
-        const bool home_key_usable = home_key != SDL_SCANCODE_UNKNOWN && !KeyUsedByGameControls(home_key);
-        e.home_key_conflict = home_key != SDL_SCANCODE_UNKNOWN && !home_key_usable;
+        // the Home shortcut may have modifiers (Shift+H, the default since NEXUS 0.6): then the
