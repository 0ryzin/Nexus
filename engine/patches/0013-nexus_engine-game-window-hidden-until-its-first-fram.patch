+/// NEXUS: create the game window hidden; the NEXUS engine shows it when the game presents its
+/// first frame, so the NEXUS loading screen stays visible (and no unpainted window appears) while
+/// the game loads.
+inline bool& NexusStartHidden() {
+    static bool hidden = false;
+    return hidden;
+}
+
 inline SDL_WindowFlags Nx2HiddenWindowFlags() {
     const char* hide = std::getenv("EDEN_NX2_HIDE_WINDOW");
-    return hide != nullptr && hide[0] != '0' ? SDL_WINDOW_HIDDEN | SDL_WINDOW_NOT_FOCUSABLE
-                                                         : SDL_WindowFlags{0};
+    if (hide != nullptr && hide[0] != '0') {
+        return SDL_WINDOW_HIDDEN | SDL_WINDOW_NOT_FOCUSABLE;
+    }
+    return NexusStartHidden() ? SDL_WINDOW_HIDDEN : SDL_WindowFlags{0};
 }
 
