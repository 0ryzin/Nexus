+                    E().load_done = done;
+                    E().load_total = total;
+                });
+            e.load_stage = 0;
         }
         system.RegisterExitCallback([] { E().stop_requested = true; }); // the game quit itself
 
@@ -374,6 +443,17 @@ void RunSession(Request req) {
         const std::uint64_t presents_at_start = Core::g_nx2_present_count.load();
         void(system.Run());
         e.state = State::Running;
+        const auto running_since = std::chrono::steady_clock::now();
+
+        // NEXUS Home on the keyboard: only when the key is not one of the game controls
+        const SDL_Scancode home_key =
+            req.home_key.empty() ? SDL_SCANCODE_UNKNOWN : SDL_GetScancodeFromName(req.home_key.c_str());
+        const bool home_key_usable = home_key != SDL_SCANCODE_UNKNOWN && !KeyUsedByGameControls(home_key);
+        e.home_key_conflict = home_key != SDL_SCANCODE_UNKNOWN && !home_key_usable;
+        if (e.home_key_conflict) {
+            LOG_WARNING(Frontend, "NEXUS Engine: the Home key {} is a game control; it goes to the game",
+                        req.home_key);
+        }
 
         // Event loop: input, window events, live volume, stop requests.
         int applied_volume = e.volume.load();
@@ -381,9 +461,37 @@ void RunSession(Request req) {
             SDL_Event event;
             if (SDL_WaitEventTimeout(&event, 4)) {
                 do {
+                    // NEXUS Home: the configured key (when no game control uses it) and the
+                    // controller's Guide/Home button are taken by NEXUS and not passed to the game
+                    if (home_key_usable && (event.type == SDL_EVENT_KEY_DOWN || event.type == SDL_EVENT_KEY_UP) &&
+                        event.key.scancode == home_key) {
+                        if (event.type == SDL_EVENT_KEY_DOWN && !event.key.repeat) {
+                            ++e.home_presses;
+                        }
+                        continue;
+                    }
+                    if (req.home_button && event.type == SDL_EVENT_GAMEPAD_BUTTON_DOWN &&
+                        event.gbutton.button == SDL_GAMEPAD_BUTTON_GUIDE) {
+                        ++e.home_presses;
+                        continue;
+                    }
                     window->OnEvent(event);
                 } while (SDL_PollEvent(&event));
             }
+            // show the game window with its first frame (or after 20 s if a program never
+            // presents one), so no empty window covers the NEXUS loading screen
+            if (!e.shown && (e.frames > 0 || std::chrono::steady_clock::now() - running_since >
+                                                 std::chrono::seconds(20))) {
+                SDL_Window* sdl_window = window->GetSDLWindow();
+                if (!e.suspended) {
+                    SDL_ShowWindow(sdl_window);
+                    if (req.fullscreen) {
+                        window->ApplyFullscreen();
+                    }
+                    SDL_RaiseWindow(sdl_window);
+                }
+                e.shown = true;
+            }
             window->ApplyPendingTitle();
             // Home in NEXUS: pause emulation and hide the game window; resume shows it again.
             if (const int req_s = e.suspend_request.exchange(-1); req_s >= 0) {
@@ -394,7 +502,9 @@ void RunSession(Request req) {
                     e.suspended = true;
                     LOG_INFO(Frontend, "NEXUS Engine: suspended (Home)");
                 } else if (req_s == 0 && e.suspended) {
-                    SDL_ShowWindow(sdl_window);
+                    if (e.shown) {
+                        SDL_ShowWindow(sdl_window);
+                    }
                     SDL_RaiseWindow(sdl_window);
                     void(system.Run());
                     e.suspended = false;
@@ -502,6 +612,8 @@ NEXUS_API int32_t nexus_engine_start(const char* request_json) {
             }
         }
         req.controller_type = j.value("controllerType", std::string{});
+        req.home_key = j.value("homeKey", std::string{});
+        req.home_button = j.value("homeButton", true);
         if (const auto it = j.find("contents"); it != j.end() && it->is_array()) {
             for (const auto& c : *it) {
                 if (c.is_string()) {
@@ -547,6 +659,14 @@ NEXUS_API int32_t nexus_engine_status(char* buf, int32_t buf_len) {
         j["programId"] = hex;
     }
     j["suspended"] = e.suspended.load();
+    j["shown"] = e.shown.load();
+    j["homePresses"] = e.home_presses.load();
+    j["homeKeyConflict"] = e.home_key_conflict.load();
+    if (const int st = e.load_stage.load(); st != 0) {
