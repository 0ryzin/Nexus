+// Whether a keyboard key is bound to any of player 1's controls (buttons, sticks, motion), so
+// NEXUS never takes a key the game needs. Keyboard bindings are "engine:keyboard,code:<scancode>";
+// stick bindings nest them as "code$0<scancode>".
+bool KeyUsedByGameControls(SDL_Scancode key) {
+    const auto& player = Settings::values.players.GetValue()[0];
+    const std::string code = std::to_string(static_cast<int>(key));
+    const auto uses = [&](const std::string& param) {
+        if (param.find("keyboard") == std::string::npos) {
+            return false;
+        }
+        for (const std::string& marker : {std::string{"code:"}, std::string{"code$0"}}) {
+            for (std::size_t at = param.find(marker); at != std::string::npos;
+                 at = param.find(marker, at + 1)) {
+                const std::size_t begin = at + marker.size();
+                std::size_t end = begin;
+                while (end < param.size() && std::isdigit(static_cast<unsigned char>(param[end]))) {
+                    ++end;
+                }
+                if (param.compare(begin, end - begin, code) == 0 && end > begin) {
+                    return true;
+                }
+            }
+        }
+        return false;
+    };
+    for (const auto& b : player.buttons) {
+        if (uses(b)) {
+            return true;
+        }
+    }
+    for (const auto& a : player.analogs) {
+        if (uses(a)) {
+            return true;
+        }
+    }
+    for (const auto& m : player.motions) {
+        if (uses(m)) {
+            return true;
+        }
+    }
+    return false;
+}
+
 void RunSession(Request req) {
     Engine& e = E();
     e.frames = 0;
