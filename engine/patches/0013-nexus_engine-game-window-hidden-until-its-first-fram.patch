+        j["loadDone"] = e.load_done.load();
+        j["loadTotal"] = e.load_total.load();
+    }
     if (const int gen = e.system_gen.load(); gen != 0) {
         j["system"] = gen == 2 ? "switch2" : "switch1";
     }
