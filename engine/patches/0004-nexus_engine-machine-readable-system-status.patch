Subject: [PATCH 04/14] nexus_engine: machine-readable system status

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01X7yw1ZJY9GYi2KYHfiXxvY
(cherry picked from commit 969b55bf2b59441528d6bee8d4bfdba0a83b9999)
---
 src/nexus_engine/nexus_engine.cpp | 4 ++--
 1 file changed, 2 insertions(+), 2 deletions(-)

diff --git a/src/nexus_engine/nexus_engine.cpp b/src/nexus_engine/nexus_engine.cpp
index 0616ec07e..bb799eb05 100644
--- a/src/nexus_engine/nexus_engine.cpp
+++ b/src/nexus_engine/nexus_engine.cpp
@@ -364,11 +364,11 @@ std::string BuildInfo() {
     json sw1 = json::object();
     sw1["id"] = "switch1";
     sw1["name"] = "Nintendo Switch";
-    sw1["status"] = "engine core";
+    sw1["status"] = "core";
     json sw2 = json::object();
     sw2["id"] = "switch2";
     sw2["name"] = "Nintendo Switch 2";
-    sw2["status"] = "experimental upstream code (nx2 work); untested by NEXUS";
+    sw2["status"] = "experimental"; // upstream nx2 work; not tested with games by NEXUS
     j["systems"] = json::array();
     j["systems"].push_back(sw1);
     j["systems"].push_back(sw2);
