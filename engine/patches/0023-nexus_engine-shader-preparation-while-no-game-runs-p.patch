+// Prepares a game's shaders while no game runs (see RunPrepare). Returns 0 when started, -1 while
+// a game or another preparation runs, -2 for a bad request.
+NEXUS_API int32_t nexus_engine_prepare_shaders(const char* request_json) {
+    Engine& e = E();
+    const State s = e.state.load();
+    if (s == State::Starting || s == State::Running || s == State::Stopping ||
+        e.prep_state.load() == PrepRunning) {
+        return -1;
+    }
+    PrepRequest req;
+    try {
+        const json j = json::parse(request_json ? request_json : "{}");
+        req.game = j.at("game").get<std::string>();
+        req.data_dir = j.at("dataDir").get<std::string>();
+        req.config_file = j.at("configFile").get<std::string>();
+        req.title_id = std::stoull(j.at("titleId").get<std::string>(), nullptr, 16);
+        req.force = j.value("force", false);
+        if (const auto it = j.find("contents"); it != j.end() && it->is_array()) {
+            for (const auto& c : *it) {
+                if (c.is_string()) {
+                    req.contents.push_back(c.get<std::string>());
+                }
+            }
+        }
+    } catch (const std::exception&) {
+        return -2;
+    }
+    if (req.title_id == 0) {
+        return -2;
+    }
+    if (e.prep_thread.joinable()) {
+        e.prep_thread.join();
+    }
+    if (e.thread.joinable() && (s == State::Idle || s == State::Stopped || s == State::Error)) {
+        e.thread.join(); // a finished session's thread
+    }
+    {
+        std::scoped_lock lk{e.mutex};
+        e.prep_title = req.title_id;
+        e.prep_stage.clear();
+        e.prep_error.clear();
+        e.prep_archives = e.prep_programs = e.prep_skipped = 0;
+        e.prep_seconds = 0;
+    }
+    e.prep_done = 0;
+    e.prep_total = 0;
+    e.prep_stop = std::stop_source{};
+    e.prep_state = PrepRunning;
+    e.prep_thread = std::thread([req, stop = e.prep_stop.get_token()] {
+        try {
+            RunPrepare(req, stop);
+        } catch (const std::exception& ex) {
+            {
+                std::scoped_lock lk{E().mutex};
+                E().prep_error = ex.what();
+            }
+            E().prep_state = PrepFailed;
+        }
+    });
+    return 0;
+}
+
+// Stops a running preparation after its current step (the file is left as it was).
+NEXUS_API void nexus_engine_prepare_cancel(void) {
+    E().prep_stop.request_stop();
+}
+
+// The loading screen's "Start now": the boot precache stops after its running builds and the
+// game starts; the remaining programs are built when the game first uses them.
+NEXUS_API void nexus_engine_skip_precache(void) {
+    VideoCommon::ShaderWarm::RequestSkipWarm();
+}
