+// NEXUS shader preparation: Lichii's shader precache builder (shader_warm) run for a game while
+// no game is running. It reads the game's own files with the user's keys, finds the shader
+// programs in its shader archives, converts the compute programs and writes the title's precache
+// file (<shader dir>/<title id>/warm-compute.bin). The next boot builds those compute pipelines
+// before the game starts when precache_shaders is Always. Graphics pipelines need render state the
+// game files do not have; they come from the shader cache of earlier sessions.
+struct PrepRequest {
+    std::string game;
+    std::string data_dir;
+    std::string config_file;
+    std::uint64_t title_id{};
+    std::vector<std::string> contents;
+    bool force{};
+};
+
+void RunPrepare(PrepRequest req, std::stop_token stop) {
+    namespace ShaderWarm = VideoCommon::ShaderWarm;
+    Engine& e = E();
+    const auto begin = std::chrono::steady_clock::now();
+    const auto finish = [&](PrepState state, std::string error) {
+        {
+            std::scoped_lock lk{e.mutex};
+            e.prep_error = std::move(error);
+            e.prep_seconds =
+                std::chrono::duration<double>(std::chrono::steady_clock::now() - begin).count();
+        }
+        e.prep_state = state;
+    };
+    Common::FS::SetAppDirectory(req.data_dir);
+    if (!e.logging_started) {
+        Common::Log::Initialize();
+        Common::Log::Start();
+        e.logging_started = true;
+    }
+    LOG_INFO(Frontend, "NEXUS Engine: preparing shaders for {:016X} from {}", req.title_id, req.game);
+    SdlConfig config{req.config_file};
+    if (!e.system) {
+        e.system = std::make_unique<Core::System>();
+        e.input = std::make_unique<InputCommon::InputSubsystem>();
+        e.system->Initialize();
+    }
+    Core::System& system = *e.system;
+    system.ApplySettings();
+    system.SetContentProvider(std::make_unique<FileSys::ContentProviderUnion>());
+    static FileSys::ManualContentProvider prep_provider;
+    system.RegisterContentProvider(FileSys::ContentProviderUnionSlot::FrontendManual, &prep_provider);
+    system.SetFilesystem(std::make_shared<FileSys::RealVfsFilesystem>());
+    system.GetFileSystemController().CreateFactories(*system.GetFilesystem());
+    RegisterExternalContent(prep_provider, system, req.game, req.contents);
+
+    const auto path = ShaderWarm::ComputeWarmPath(req.title_id);
+    const auto stale = ShaderWarm::WarmFilesStale(path);
+    if (!req.force && !stale) {
+        LOG_INFO(Frontend, "NEXUS Engine: shader precache file is current");
+        std::scoped_lock lk{e.mutex};
+        e.prep_programs = ShaderWarm::ReadWarmCount(path);
+        e.prep_stage.clear();
+        e.prep_state = PrepCurrent;
+        return;
+    }
+    LOG_INFO(Frontend, "NEXUS Engine: building the shader precache file ({})",
+             stale ? *stale : std::string{"asked again"});
+    const auto result = ShaderWarm::BuildWarmFiles(
+        system, Common::FS::ToU8String(req.game), req.title_id,
+        [&](const ShaderWarm::Progress& p) {
+            {
+                std::scoped_lock lk{e.mutex};
+                e.prep_stage = p.stage;
+            }
+            e.prep_done = p.done;
+            e.prep_total = p.total;
+        },
+        stop);
+    {
+        std::scoped_lock lk{e.mutex};
+        e.prep_archives = result.archives;
+        e.prep_programs = result.compute_programs;
+        e.prep_skipped = result.skipped;
+    }
+    if (stop.stop_requested()) {
+        finish(PrepStopped, {});
+    } else if (!result.ok) {
+        finish(PrepFailed, result.error);
+    } else {
+        finish(PrepDone, {});
+    }
+}
