+// Same as the upstream frontends' "auto-map": bind player 1 to the first game controller the
+// input subsystem reports, using the driver's default mapping for that device. Only used when
+// the NEXUS user has not chosen a saved controller profile.
+void AutoMapController(InputCommon::InputSubsystem& input, Core::System& system) {
+    std::optional<Common::ParamPackage> pad;
+    for (int attempt = 0; attempt < 25 && !pad; ++attempt) { // SDL reports pads asynchronously
+        for (const auto& d : input.GetInputDevices()) {
+            const auto engine = d.Get("engine", "");
+            if (engine == "sdl" || engine == "joycon" || engine == "gcpad") {
+                pad = d;
+                break;
+            }
+        }
+        if (!pad) {
+            std::this_thread::sleep_for(std::chrono::milliseconds(20));
+        }
+    }
+    if (!pad) {
+        LOG_INFO(Frontend, "NEXUS: no game controller connected, keeping the keyboard mapping");
+        return;
+    }
+    auto& player = Settings::values.players.GetValue()[0];
+    for (const auto& [id, param] : input.GetButtonMappingForDevice(*pad)) {
+        player.buttons[id] = param.Serialize();
+    }
+    for (const auto& [id, param] : input.GetAnalogMappingForDevice(*pad)) {
+        player.analogs[id] = param.Serialize();
+    }
+    for (const auto& [id, param] : input.GetMotionMappingForDevice(*pad)) {
+        player.motions[id] = param.Serialize();
+    }
+    player.connected = true;
+    system.HIDCore().ReloadInputDevices();
+    LOG_INFO(Frontend, "NEXUS: player 1 mapped to {}", pad->Get("display", "controller"));
+}
+
+void RegisterExternalContent(FileSys::ManualContentProvider& provider, Core::System& system,
+                             const std::vector<std::string>& paths) {
+    provider.ClearAllEntries();
+    for (const auto& path : paths) {
+        if (const auto file = system.GetFilesystem()->OpenFile(path, FileSys::OpenMode::Read)) {
+            if (!provider.AddEntriesFromContainer(file)) {
+                LOG_WARNING(Frontend, "NEXUS: {} is not a usable update/DLC container", path);
+            }
+        }
+    }
+}
