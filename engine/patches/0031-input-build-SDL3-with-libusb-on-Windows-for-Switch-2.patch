diff --git a/dist/72-eden-input.rules b/dist/72-eden-input.rules
index b84ed200a..13e55a9df 100644
--- a/dist/72-eden-input.rules
+++ b/dist/72-eden-input.rules
@@ -6,3 +6,6 @@
 # Consult your distro if this is not the case
 
 KERNEL=="hidraw*", SUBSYSTEM=="hidraw", ENV{ID_INPUT_JOYSTICK}=="1", MODE="0660", TAG+="uaccess"
+
+# Switch 2 controllers over USB: SDL drives them through libusb, which needs the USB device node
+SUBSYSTEM=="usb", ENV{DEVTYPE}=="usb_device", ATTR{idVendor}=="057e", ATTR{idProduct}=="2066|2067|2069|2073", MODE="0660", TAG+="uaccess"
diff --git a/externals/CMakeLists.txt b/externals/CMakeLists.txt
index 4288af15e..9f2dfc900 100644
--- a/externals/CMakeLists.txt
+++ b/externals/CMakeLists.txt
@@ -152,7 +152,23 @@ if(ENABLE_CUBEB)
     endif()
 endif()
 
-if (NOT LICHII_USE_BUNDLED_SDL3)
+# libusb, before SDL3 so a source-built SDL3 can use it
+if (ENABLE_LIBUSB)
+    add_subdirectory(libusb)
+endif()
+
+# The prebuilt Windows SDL3 has no libusb, which SDL's Switch 2 controller driver needs
+if (MSVC AND ENABLE_LIBUSB AND LICHII_USE_BUNDLED_SDL3)
+    message(STATUS "Building SDL3 with libusb for Switch 2 controllers")
+    AddJsonPackage(NAME sdl3 FORCE_BUNDLED_PACKAGE ON OPTIONS
+        "SDL_SHARED OFF"
+        "SDL_STATIC ON"
+        "SDL_INSTALL OFF"
+        "SDL_TEST_LIBRARY OFF"
+        "SDL_HIDAPI ON"
+        "SDL_HIDAPI_LIBUSB ON"
+        "SDL_HIDAPI_LIBUSB_SHARED OFF")
+elseif (NOT LICHII_USE_BUNDLED_SDL3)
     if (NOT WIN32)
         # Yuzu itself needs: Atomic Audio Events Joystick Haptic Sensor Threads Timers
         # Since 2.0.18 Atomic+Threads required for HIDAPI/libusb (see https://github.com/libsdl-org/SDL/issues/5095)
@@ -173,7 +189,7 @@ if (NOT LICHII_USE_BUNDLED_SDL3)
         set(SDL_FILE ON)
     endif()
 
-    AddJsonPackage(sdl3)
+    AddJsonPackage(NAME sdl3 OPTIONS "SDL_INSTALL OFF")
 else()
     message(STATUS "Using bundled SDL3")
     AddJsonPackage(sdl3-ci)
@@ -268,11 +284,6 @@ endif()
 # Glad
 add_subdirectory(glad)
 
-# libusb
-if (ENABLE_LIBUSB)
-    add_subdirectory(libusb)
-endif()
-
 # VMA
 AddJsonPackage(vulkan-memory-allocator)
 
diff --git a/src/input_common/drivers/sdl_driver.cpp b/src/input_common/drivers/sdl_driver.cpp
index 2ead612f2..9dda5a7dd 100644
--- a/src/input_common/drivers/sdl_driver.cpp
+++ b/src/input_common/drivers/sdl_driver.cpp
@@ -655,6 +655,10 @@ public:
             default:
                 break;
             }
+            if (SDL_GetGamepadVendor(sdl_controller.get()) == 0x057E &&
+                SDL_GetGamepadProduct(sdl_controller.get()) == 0x2069) {
+                return "Nintendo Switch 2 Pro Controller";
+            }
             const auto name = SDL_GetGamepadName(sdl_controller.get());
             if (name) {
                 return name;
@@ -1060,6 +1064,9 @@ SDLDriver::SDLDriver(std::string input_engine_) : InputEngine(std::move(input_en
         SDL_SetHintWithPriority(SDL_HINT_JOYSTICK_RAWINPUT_CORRELATE_XINPUT, "0", SDL_HINT_OVERRIDE);
         SDL_SetHintWithPriority(SDL_HINT_JOYSTICK_WGI, "0", SDL_HINT_OVERRIDE);
     }
+    // SDL is built with libusb on Windows for Switch 2 controllers. Leave the GameCube adapter to
+    // the GC adapter driver, which claims it through libusb itself.
+    SDL_SetHint(SDL_HINT_HIDAPI_LIBUSB_GAMECUBE, "0");
 #endif
 
     // SDL3 defaults Steam Controller Bluetooth HIDAPI support to off, which can disable gyro.
