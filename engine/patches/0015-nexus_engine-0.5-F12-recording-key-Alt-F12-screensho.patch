+/// A keyboard shortcut: a key with an exact set of modifiers ("F12", "Alt+F12", "Ctrl+Shift+S").
+struct Shortcut {
+    SDL_Scancode key{SDL_SCANCODE_UNKNOWN};
+    SDL_Keymod mods{SDL_KMOD_NONE};
+    bool Matches(const SDL_KeyboardEvent& k) const;
+};
+
+SDL_Keymod NormalMods(SDL_Keymod m) {
+    SDL_Keymod out = SDL_KMOD_NONE;
+    if (m & SDL_KMOD_CTRL) out = static_cast<SDL_Keymod>(out | SDL_KMOD_CTRL);
+    if (m & SDL_KMOD_SHIFT) out = static_cast<SDL_Keymod>(out | SDL_KMOD_SHIFT);
+    if (m & SDL_KMOD_ALT) out = static_cast<SDL_Keymod>(out | SDL_KMOD_ALT);
+    if (m & SDL_KMOD_GUI) out = static_cast<SDL_Keymod>(out | SDL_KMOD_GUI);
+    return out;
+}
+
+bool Shortcut::Matches(const SDL_KeyboardEvent& k) const {
+    return key != SDL_SCANCODE_UNKNOWN && k.scancode == key && NormalMods(k.mod) == mods;
+}
+
+Shortcut ParseShortcut(const std::string& text) {
+    Shortcut sc;
+    std::string rest = text;
+    std::size_t plus;
+    // the last part is the key ("+" alone or at the end is not a modifier separator)
+    while ((plus = rest.find('+')) != std::string::npos && plus + 1 < rest.size()) {
+        std::string mod = rest.substr(0, plus);
+        for (auto& c : mod) c = static_cast<char>(std::tolower(static_cast<unsigned char>(c)));
+        if (mod == "ctrl" || mod == "control") sc.mods = static_cast<SDL_Keymod>(sc.mods | SDL_KMOD_CTRL);
+        else if (mod == "shift") sc.mods = static_cast<SDL_Keymod>(sc.mods | SDL_KMOD_SHIFT);
+        else if (mod == "alt") sc.mods = static_cast<SDL_Keymod>(sc.mods | SDL_KMOD_ALT);
+        else if (mod == "win" || mod == "gui" || mod == "cmd" || mod == "super") sc.mods = static_cast<SDL_Keymod>(sc.mods | SDL_KMOD_GUI);
+        else return {};
+        rest = rest.substr(plus + 1);
+    }
+    sc.key = rest.empty() ? SDL_SCANCODE_UNKNOWN : SDL_GetScancodeFromName(rest.c_str());
+    return sc;
+}
