+/// F11: fullscreen <-> window, keeping the game running. The window comes back at 16:9 on the
+/// display it is on, at most 80% of that display.
+void ToggleFullscreen(EmuWindow_SDL3& window) {
+    SDL_Window* w = window.GetSDLWindow();
+    const bool fullscreen = (SDL_GetWindowFlags(w) & SDL_WINDOW_FULLSCREEN) != 0;
+    if (fullscreen) {
+        const SDL_DisplayID display = SDL_GetDisplayForWindow(w);
+        SDL_SetWindowFullscreen(w, false);
+        SDL_SyncWindow(w);
+        SDL_Rect area{};
+        if (display != 0 && SDL_GetDisplayUsableBounds(display, &area) && area.w > 0 && area.h > 0) {
+            int ww = area.w * 8 / 10;
+            int wh = ww * 9 / 16;
+            if (wh > area.h * 8 / 10) {
+                wh = area.h * 8 / 10;
+                ww = wh * 16 / 9;
+            }
+            SDL_SetWindowSize(w, ww, wh);
+            SDL_SetWindowPosition(w, static_cast<int>(SDL_WINDOWPOS_CENTERED_DISPLAY(display)),
+                                  static_cast<int>(SDL_WINDOWPOS_CENTERED_DISPLAY(display)));
+        }
+        E().fullscreen_now = false;
+        LOG_INFO(Frontend, "NEXUS: windowed");
+    } else {
+        if ((SDL_GetWindowFlags(w) & SDL_WINDOW_MAXIMIZED) != 0) {
+            SDL_RestoreWindow(w);
+        }
+        window.ApplyFullscreen();
+        E().fullscreen_now = (SDL_GetWindowFlags(w) & SDL_WINDOW_FULLSCREEN) != 0;
+        LOG_INFO(Frontend, "NEXUS: fullscreen");
+    }
 }
 
