+// SPDX-FileCopyrightText: 2026 NEXUS project
+// SPDX-License-Identifier: GPL-3.0-or-later
+
+// NEXUS save folders: when the host names a game's save folders, account and device saves of
+// that game resolve to them (by application ID, also for a program index of that application);
+// every other save keeps the upstream path, and an empty table changes nothing.
+
+#include <catch2/catch_test_macros.hpp>
+
+#include "core/file_sys/savedata_factory.h"
+#include "core/file_sys/vfs/vfs_vector.h"
+
+using FileSys::NexusSaveFolders;
+using FileSys::SaveDataFactory;
+using FileSys::SaveDataSpaceId;
+using FileSys::SaveDataType;
+
+TEST_CASE("NEXUS: game saves resolve to the folders NEXUS named", "[nexus][savedata]") {
+    const u128 user{0x1122334455667788ULL, 0x99AABBCCDDEEFF00ULL};
+    constexpr u64 oot = 0x0400486024DEC000ULL;
+    const FileSys::VirtualDir root = std::make_shared<FileSys::VectorVfsDirectory>();
+    const auto path = [&](SaveDataSpaceId space, SaveDataType type, u64 title) {
+        return SaveDataFactory::GetFullPath(oot, root, space, type, title, user, 0);
+    };
+    NexusSaveFolders().clear();
+    const std::string upstream = path(SaveDataSpaceId::User, SaveDataType::Account, oot);
+    REQUIRE(upstream.find("/user/save/0000000000000000/") == 0);
+
+    NexusSaveFolders()[oot] = {"0400486024DEC000-OOT", "0400486024DEC000-OOT (device)"};
+    CHECK(path(SaveDataSpaceId::User, SaveDataType::Account, oot) == "/0400486024DEC000-OOT");
+    CHECK(path(SaveDataSpaceId::User, SaveDataType::Account, 0) == "/0400486024DEC000-OOT"); // current program
+    CHECK(path(SaveDataSpaceId::User, SaveDataType::Device, oot) == "/0400486024DEC000-OOT (device)");
+    CHECK(path(SaveDataSpaceId::User, SaveDataType::Account, oot + 1) == "/0400486024DEC000-OOT"); // program index
+    // other games, other save types and spaces keep the upstream layout
+    CHECK(path(SaveDataSpaceId::User, SaveDataType::Account, 0x0100AAAA00010000ULL).find("/user/save/") == 0);
+    CHECK(path(SaveDataSpaceId::User, SaveDataType::Cache, oot).find("/user/save/cache/") == 0);
+    CHECK(path(SaveDataSpaceId::Temporary, SaveDataType::Temporary, oot).find("/temp/") == 0);
+
+    NexusSaveFolders().clear();
+    CHECK(path(SaveDataSpaceId::User, SaveDataType::Account, oot) == upstream);
+}
