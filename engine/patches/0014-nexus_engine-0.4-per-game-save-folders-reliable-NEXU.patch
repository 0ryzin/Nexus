+/// Maps players to game controllers: the controllers NEXUS chose (by GUID and port), in player
+/// order, or the first connected controller for player 1.
+void AutoMapController(InputCommon::InputSubsystem& input, Core::System& system,
+                       const std::map<std::string, std::string>& button_map,
+                       const std::string& controller_type,
+                       const std::vector<std::pair<std::string, int>>& wanted) {
+    std::vector<Common::ParamPackage> pads;
+    for (int attempt = 0; attempt < 25; ++attempt) { // SDL reports pads asynchronously
+        pads.clear();
+        for (const auto& d : input.GetInputDevices()) {
+            const auto engine = d.Get("engine", "");
+            if (engine == "sdl" || engine == "joycon" || engine == "gcpad") {
+                pads.push_back(d);
+            }
+        }
+        bool all = !pads.empty();
+        for (const auto& [guid, port] : wanted) {
+            const bool found = std::any_of(pads.begin(), pads.end(), [&](const auto& d) {
+                return d.Get("guid", "") == guid && d.Get("port", 0) == port;
+            });
+            all = all && found;
+        }
+        if (all) {
+            break;
+        }
+        std::this_thread::sleep_for(std::chrono::milliseconds(20));
+    }
+    if (pads.empty()) {
+        LOG_INFO(Frontend, "NEXUS: no game controller connected, keeping the keyboard mapping");
+        return;
+    }
+    std::vector<Common::ParamPackage> order;
+    for (const auto& [guid, port] : wanted) {
+        auto it = std::find_if(pads.begin(), pads.end(), [&](const auto& d) {
+            return d.Get("guid", "") == guid && d.Get("port", 0) == port;
+        });
+        if (it == pads.end()) {
+            it = std::find_if(pads.begin(), pads.end(),
+                              [&](const auto& d) { return d.Get("guid", "") == guid; });
+        }
+        if (it != pads.end()) {
+            order.push_back(*it);
+        } else {
+            LOG_WARNING(Frontend, "NEXUS: chosen controller {} (port {}) is not connected", guid, port);
+        }
+    }
+    if (order.empty()) {
+        order.push_back(pads.front());
+    }
+    const std::size_t players = std::min<std::size_t>(order.size(), 8);
+    for (std::size_t i = 0; i < players; ++i) {
+        MapPlayer(input, i, order[i], button_map, controller_type);
+    }
     system.HIDCore().ReloadInputDevices();
-    LOG_INFO(Frontend, "NEXUS: player 1 mapped to {}", pad->Get("display", "controller"));
