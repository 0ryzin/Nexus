+/// Writes a screenshot (BGRA rows from the renderer) as a PNG with a unique name in NEXUS's
+/// screenshot folder. Never overwrites a file.
+void WriteScreenshot(std::shared_ptr<std::vector<u8>> pixels, u32 width, u32 height, bool invert_y,
+                     std::string dir, std::string name) {
+    std::vector<u8>& px = *pixels;
+    for (std::size_t i = 0; i + 3 < px.size(); i += 4) {
+        std::swap(px[i], px[i + 2]); // BGRA -> RGBA
+        px[i + 3] = 0xFF;
+    }
+    if (invert_y) {
+        const std::size_t row = std::size_t{width} * 4;
+        std::vector<u8> tmp(row);
+        for (u32 y = 0; y < height / 2; ++y) {
+            u8* a = px.data() + y * row;
+            u8* b = px.data() + (height - 1 - y) * row;
+            std::memcpy(tmp.data(), a, row);
+            std::memcpy(a, b, row);
+            std::memcpy(b, tmp.data(), row);
+        }
+    }
+    std::error_code ec;
+    const std::filesystem::path folder = PathFromUtf8(dir);
+    std::filesystem::create_directories(folder, ec);
+    const auto now = std::chrono::system_clock::to_time_t(std::chrono::system_clock::now());
+    std::tm tm{};
+#ifdef _WIN32
+    localtime_s(&tm, &now);
+#else
+    localtime_r(&now, &tm);
+#endif
+    char stamp[32];
+    std::strftime(stamp, sizeof(stamp), "%Y-%m-%d %H-%M-%S", &tm);
+    std::filesystem::path target;
+    for (int n = 1; n < 1000; ++n) {
+        const std::string file = n == 1 ? fmt::format("{} {}.png", name, stamp)
+                                        : fmt::format("{} {} ({}).png", name, stamp, n);
+        target = folder / PathFromUtf8(file);
+        if (!std::filesystem::exists(target, ec)) {
+            break;
+        }
+    }
+    std::filesystem::path partial = target;
+    partial += ".part";
+    bool ok = false;
+    {
+        std::ofstream out(partial, std::ios::binary | std::ios::trunc);
+        if (out) {
+            const int written = stbi_write_png_to_func(
+                [](void* ctx, void* data, int size) {
+                    static_cast<std::ofstream*>(ctx)->write(static_cast<const char*>(data), size);
+                },
+                &out, static_cast<int>(width), static_cast<int>(height), 4, px.data(),
+                static_cast<int>(width * 4));
+            ok = written != 0 && out.good();
+        }
+    }
+    if (ok) {
+        std::filesystem::rename(partial, target, ec);
+        ok = !ec;
+    }
+    if (!ok) {
+        std::filesystem::remove(partial, ec);
+        ++E().screenshot_failures;
+        LOG_ERROR(Frontend, "NEXUS: the screenshot could not be saved in {}", dir);
+        return;
+    }
+    {
+        std::scoped_lock lk{E().mutex};
+        E().last_screenshot = PathToUtf8(target);
+    }
+    ++E().screenshots;
+    LOG_INFO(Frontend, "NEXUS: screenshot {}", PathToUtf8(target));
+}
+
+void TakeScreenshot(Core::System& system, const Request& req) {
+    if (req.screenshot_dir.empty()) {
+        return;
+    }
+    auto& renderer = system.Renderer();
+    if (renderer.IsScreenshotPending()) {
+        return;
+    }
+    const float scale = std::max(1.0f, Settings::values.resolution_info.up_factor);
+    const u32 height = static_cast<u32>((Settings::IsDockedMode() ? Layout::ScreenDocked::Height
+                                                                  : Layout::ScreenUndocked::Height) *
+                                        scale);
+    const u32 width = height * 16 / 9;
+    const auto layout = Layout::DefaultFrameLayout(width, height);
+    auto pixels = std::make_shared<std::vector<u8>>(std::size_t{width} * height * 4);
+    const std::string dir = req.screenshot_dir;
+    const std::string name = req.screenshot_name;
+    renderer.RequestScreenshot(
+        pixels->data(),
+        [pixels, width, height, dir, name](bool invert_y) {
+            std::thread(WriteScreenshot, pixels, width, height, invert_y, dir, name).detach();
+        },
+        layout);
+}
