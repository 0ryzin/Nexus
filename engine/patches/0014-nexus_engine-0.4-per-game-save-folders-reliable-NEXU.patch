+NEXUS_API int32_t nexus_engine_controllers(char* buf, int32_t buf_len) {
+    Engine& e = E();
+    json list = json::array();
+    const State s = e.state.load();
+    const bool session = s == State::Starting || s == State::Running || s == State::Stopping;
+    // outside a session SDL's game controller subsystem is opened just for the listing
+    // (reference-counted; the session's input layer starts its own afterwards)
+    if (!session && SDL_InitSubSystem(SDL_INIT_GAMEPAD)) {
+        for (int i = 0; i < 3; ++i) {
+            SDL_UpdateGamepads();
+            std::this_thread::sleep_for(std::chrono::milliseconds(15));
+        }
+    } else if (!session) {
+        return -1;
+    }
+    int count = 0;
+    SDL_JoystickID* ids = SDL_GetGamepads(&count);
+    std::map<std::string, int> ports;
+    for (int i = 0; ids != nullptr && i < count; ++i) {
+        const SDL_JoystickID id = ids[i];
+        json pad = json::object();
+        const SDL_GUID guid = SDL_GetJoystickGUIDForID(id);
+        Common::UUID uuid{};
+        std::memcpy(uuid.uuid.data(), guid.data, sizeof(guid.data));
+        const std::string g = uuid.RawString();
+        pad["guid"] = g;
+        pad["port"] = ports[g]++;
+        if (const char* name = SDL_GetGamepadNameForID(id)) {
+            pad["name"] = name;
+        }
+        pad["vendor"] = SDL_GetJoystickVendorForID(id);
+        pad["product"] = SDL_GetJoystickProductForID(id);
+        if (const char* path = SDL_GetJoystickPathForID(id)) {
+            pad["path"] = path;
+        }
+        const char* type = "standard";
+        switch (SDL_GetGamepadTypeForID(id)) {
+        case SDL_GAMEPAD_TYPE_XBOX360: type = "xbox360"; break;
+        case SDL_GAMEPAD_TYPE_XBOXONE: type = "xboxone"; break;
+        case SDL_GAMEPAD_TYPE_PS3: type = "ps3"; break;
+        case SDL_GAMEPAD_TYPE_PS4: type = "ps4"; break;
+        case SDL_GAMEPAD_TYPE_PS5: type = "ps5"; break;
+        case SDL_GAMEPAD_TYPE_NINTENDO_SWITCH_PRO: type = "switch-pro"; break;
+        case SDL_GAMEPAD_TYPE_NINTENDO_SWITCH_JOYCON_LEFT: type = "joycon-left"; break;
+        case SDL_GAMEPAD_TYPE_NINTENDO_SWITCH_JOYCON_RIGHT: type = "joycon-right"; break;
+        case SDL_GAMEPAD_TYPE_NINTENDO_SWITCH_JOYCON_PAIR: type = "joycon-pair"; break;
+        default: break;
+        }
+        pad["type"] = type;
+        if (!session) { // the serial number needs the device opened (not during a game)
+            if (SDL_Gamepad* gp = SDL_OpenGamepad(id)) {
+                if (const char* serial = SDL_GetGamepadSerial(gp)) {
+                    pad["serial"] = serial;
+                }
+                SDL_CloseGamepad(gp);
+            }
+        }
+        list.push_back(pad);
+    }
+    SDL_free(ids);
+    if (!session) {
+        SDL_QuitSubSystem(SDL_INIT_GAMEPAD);
+    }
+    const std::string text = list.dump();
+    if (buf != nullptr && buf_len > 0) {
+        const auto n = std::min<std::size_t>(text.size(), static_cast<std::size_t>(buf_len - 1));
+        std::memcpy(buf, text.data(), n);
+        buf[n] = '\0';
+    }
+    return static_cast<int32_t>(text.size());
+}
