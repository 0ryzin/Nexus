+    const vec2 forward_unclamped = uv + motion * blend_factor;
+    const vec2 backward_unclamped = uv - motion * (1.0 - blend_factor);
+    const vec2 forward_uv = clamp(forward_unclamped, 0.0, 1.0);
+    const vec2 backward_uv = clamp(backward_unclamped, 0.0, 1.0);
+    const vec4 forward_color = texture(PreviousFrame, forward_uv);
+    const vec4 backward_color = texture(CurrentFrame, backward_uv);
+
+    // A sample is unusable off screen (content entering or leaving exists in one frame only) or,
+    // for a moving pixel, on static content seen through the motion. Use the other one then.
+    bool forward_valid = forward_unclamped == forward_uv;
+    bool backward_valid = backward_unclamped == backward_uv;
+    if (length(motion * render_size) > 1.0) {
+        forward_valid = forward_valid &&
+                        ColorDistance(forward_color, texture(CurrentFrame, forward_uv)) >=
