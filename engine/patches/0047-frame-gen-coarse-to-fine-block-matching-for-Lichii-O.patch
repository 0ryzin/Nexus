-    // ── Anti-flicker: blend with un-warped centre pixel ─────────────
-    float motion_magnitude = length(motion * render_size);
-    float direct_weight = exp(-motion_magnitude * 0.5);
-    vec4 center_color = mix(texture(PreviousFrame, uv), texture(CurrentFrame, uv), blend_factor);
-    interpolated = mix(interpolated, center_color, direct_weight * 0.3);
+    vec4 interpolated;
+    if (forward_valid != backward_valid) {
+        interpolated = forward_valid ? forward_color : backward_color;
+    } else {
+        // Where the two warped samples disagree, the motion doesn't describe this pixel (an
+        // animation frame changed, or something was uncovered). Blending them ghosts both
+        // versions, so show the nearer real frame there instead.
+        interpolated = mix(forward_color, backward_color, blend_factor);
+        const vec4 nearest = blend_factor < 0.5 ? previous_here : current_here;
+        interpolated = mix(interpolated, nearest,
