+#ifdef _WIN32
+/// NEXUS 0.6: makes the game window a child of the NEXUS window, filling its client area, so the
+/// game is part of the one NEXUS window (moving, resizing, minimising and full screen are the
+/// NEXUS window's). Done when the game is revealed, after loading, from the engine thread, which
+/// pumps its messages every few milliseconds from then on.
+HWND GameHwnd(SDL_Window* window) {
+    return window ? static_cast<HWND>(SDL_GetPointerProperty(SDL_GetWindowProperties(window),
+                                                             SDL_PROP_WINDOW_WIN32_HWND_POINTER, nullptr))
+                  : nullptr;
+}
+
+bool EmbedInHost(SDL_Window* window, std::uintptr_t owner) {
+    HWND hwnd = GameHwnd(window);
+    HWND host = reinterpret_cast<HWND>(owner);
+    if (hwnd == nullptr || host == nullptr || !IsWindow(host)) {
+        return false;
+    }
+    if ((SDL_GetWindowFlags(window) & SDL_WINDOW_FULLSCREEN) != 0) {
+        SDL_SetWindowFullscreen(window, false);
+        SDL_SyncWindow(window);
+    }
+    LONG_PTR style = GetWindowLongPtrW(hwnd, GWL_STYLE);
+    style &= ~static_cast<LONG_PTR>(WS_POPUP | WS_CAPTION | WS_THICKFRAME | WS_SYSMENU | WS_MINIMIZEBOX |
+                                    WS_MAXIMIZEBOX | WS_BORDER | WS_DLGFRAME);
+    style |= WS_CHILD | WS_CLIPSIBLINGS | WS_CLIPCHILDREN;
+    LONG_PTR ex = GetWindowLongPtrW(hwnd, GWL_EXSTYLE);
+    ex &= ~static_cast<LONG_PTR>(WS_EX_APPWINDOW | WS_EX_WINDOWEDGE | WS_EX_CLIENTEDGE | WS_EX_DLGMODALFRAME |
+                                 WS_EX_TOPMOST | WS_EX_LAYERED);
+    SetWindowLongPtrW(hwnd, GWLP_HWNDPARENT, 0);
+    SetWindowLongPtrW(hwnd, GWL_STYLE, style);
+    SetWindowLongPtrW(hwnd, GWL_EXSTYLE, ex);
+    SetParent(hwnd, host);
+    RECT rc{};
+    GetClientRect(host, &rc);
+    SetWindowPos(hwnd, HWND_TOP, 0, 0, rc.right - rc.left, rc.bottom - rc.top, SWP_FRAMECHANGED | SWP_NOACTIVATE);
+    return true;
+}
+
+/// Shows the embedded game in front of the NEXUS interface and gives it the keyboard.
+void ShowEmbedded(SDL_Window* window) {
+    HWND hwnd = GameHwnd(window);
+    if (hwnd == nullptr) {
+        return;
+    }
+    SDL_ShowWindow(window);
+    SetWindowPos(hwnd, HWND_TOP, 0, 0, 0, 0, SWP_NOMOVE | SWP_NOSIZE | SWP_SHOWWINDOW);
+    SetFocus(hwnd);
+}
+
+/// Keeps the embedded game the size of the NEXUS window's client area.
+void SyncEmbeddedSize(SDL_Window* window) {
+    HWND hwnd = GameHwnd(window);
+    HWND host = hwnd ? GetParent(hwnd) : nullptr;
+    if (host == nullptr || IsIconic(host)) {
+        return;
+    }
+    RECT want{}, have{};
+    GetClientRect(host, &want);
+    GetClientRect(hwnd, &have);
+    const int w = want.right - want.left, h = want.bottom - want.top;
+    if (w > 0 && h > 0 && (w != have.right - have.left || h != have.bottom - have.top)) {
+        SetWindowPos(hwnd, nullptr, 0, 0, w, h, SWP_NOZORDER | SWP_NOACTIVATE);
+    }
+}
+#endif
+
+/// NEXUS shortcuts (Home, full screen, recording, screenshots) take priority over the *default*
+/// keyboard layout: a game button that the default layout puts on one of those keys (H is the R
+/// button there) moves to a free key, so the shortcut works for keyboard players too. Bindings
+/// the user chose themselves are never changed.
+bool KeyUsedByGameControls(SDL_Scancode key);
+
+std::string FreeShortcutKeys(const std::vector<SDL_Scancode>& reserved) {
+    auto& player = Settings::values.players.GetValue()[0];
+    static constexpr std::array<SDL_Scancode, 10> spare{SDL_SCANCODE_E, SDL_SCANCODE_R, SDL_SCANCODE_Y, SDL_SCANCODE_U,
+                                                        SDL_SCANCODE_O, SDL_SCANCODE_P, SDL_SCANCODE_C, SDL_SCANCODE_V,
+                                                        SDL_SCANCODE_K, SDL_SCANCODE_L};
+    const auto is_reserved = [&](int code) {
+        return std::find(reserved.begin(), reserved.end(), static_cast<SDL_Scancode>(code)) != reserved.end();
+    };
+    std::string moves;
+    for (std::size_t i = 0; i < player.buttons.size() && i < SdlConfig::default_buttons.size(); ++i) {
+        const int def = SdlConfig::default_buttons[i];
+        if (!is_reserved(def) || player.buttons[i] != InputCommon::GenerateKeyboardParam(def)) {
+            continue;
+        }
+        for (const SDL_Scancode alt : spare) {
+            if (is_reserved(alt) || KeyUsedByGameControls(alt)) {
+                continue;
+            }
+            player.buttons[i] = InputCommon::GenerateKeyboardParam(alt);
+            const std::string what = fmt::format("{} {} -> {}", Settings::NativeButton::mapping[i],
+                                                 SDL_GetScancodeName(static_cast<SDL_Scancode>(def)), SDL_GetScancodeName(alt));
+            LOG_INFO(Frontend, "NEXUS Engine: keyboard layout: {} (the key is a NEXUS shortcut)", what);
+            moves += (moves.empty() ? "" : "; ") + what;
+            break;
+        }
+    }
+    return moves;
+}
