+NEXUS_API int32_t nexus_engine_amiibo(const char* path) {
+    Engine& e = E();
+    if (e.state.load() != State::Running || !e.input) {
+        return -1;
+    }
+    auto* amiibo = e.input->GetVirtualAmiibo();
+    if (amiibo == nullptr) {
+        return -1;
+    }
+    if (path == nullptr || *path == '\0') {
+        void(amiibo->CloseAmiibo());
+        return 0;
+    }
+    switch (amiibo->LoadAmiibo(std::string{path})) {
+    case InputCommon::VirtualAmiibo::Info::Success:
+        LOG_INFO(Frontend, "NEXUS Engine: amiibo placed");
+        return 0;
+    case InputCommon::VirtualAmiibo::Info::WrongDeviceState:
+        return 1;
+    case InputCommon::VirtualAmiibo::Info::UnableToLoad:
+        return 2;
+    case InputCommon::VirtualAmiibo::Info::NotAnAmiibo:
+        return 3;
+    default:
+        return 2;
+    }
+}
