 }
 
+fs::path WarmProgressPath(const fs::path& warm_file) {
+    fs::path progress = warm_file;
+    progress.replace_extension(".partial");
+    return progress;
+}
+
+std::unordered_set<u64> ReadWarmProgress(const fs::path& warm_file, const WarmStamp& current) {
+    std::unordered_set<u64> built;
+    std::ifstream in(WarmProgressPath(warm_file));
+    std::string format;
+    WarmStamp stamp;
+    u64 count{};
+    if (!(in >> format) || format != "v1" ||
+        !(in >> stamp.size >> stamp.content_hash >> stamp.entries >> stamp.driver >>
+          stamp.device_id >> stamp.cache_version >> stamp.variant >> count) ||
+        !stamp.Matches(current)) {
+        return {};
+    }
+    built.reserve(static_cast<size_t>(std::min<u64>(count, 1u << 20)));
+    u64 hash{};
+    while (built.size() < count && (in >> std::hex >> hash)) {
+        built.insert(hash);
+    }
+    if (built.size() != count) {
+        return {}; // cut short: trust none of it
+    }
+    return built;
+}
+
+bool WriteWarmProgress(const fs::path& warm_file, const WarmStamp& stamp,
+                       const std::vector<u64>& built) {
+    const fs::path path = WarmProgressPath(warm_file);
+    fs::path tmp = path;
+    tmp += ".tmp";
+    {
+        std::ofstream out(tmp, std::ios::trunc);
+        out << "v1 " << stamp.size << ' ' << stamp.content_hash << ' ' << stamp.entries << ' '
+            << stamp.driver << ' ' << stamp.device_id << ' ' << stamp.cache_version << ' '
+            << stamp.variant << ' ' << built.size() << '\n'
+            << std::hex;
+        for (const u64 hash : built) {
+            out << hash << '\n';
+        }
+        out.close();
+        if (!out) {
+            std::error_code ignored;
+            fs::remove(tmp, ignored);
+            return false;
+        }
+    }
+    std::error_code ec;
+    fs::rename(tmp, path, ec);
+    return !ec;
+}
