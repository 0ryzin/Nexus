+// NEXUS: a precache skipped or stopped part-way keeps what it built for the next boot.
+TEST_CASE("ShaderPrecache: progress of an unfinished precache is kept for the same stamp",
+          "[video_core]") {
+    TempDir dir;
+    const auto warm = dir.path / "warm-compute.bin";
+    WriteBytes(warm, "precache");
+    const auto stamp = *ShaderWarm::CurrentWarmStamp(warm, 4794, 0x1234, 0x2206, 53, 0x77);
+    REQUIRE(ShaderWarm::ReadWarmProgress(warm, stamp).empty());
+    REQUIRE(ShaderWarm::WarmProgressPath(warm) == dir.path / "warm-compute.partial");
+
+    const std::vector<u64> built{0x1ULL, 0xdeadbeefcafef00dULL, 0xffffffffffffffffULL};
+    REQUIRE(ShaderWarm::WriteWarmProgress(warm, stamp, built));
+    const auto back = ShaderWarm::ReadWarmProgress(warm, stamp);
+    REQUIRE(back == std::unordered_set<u64>(built.begin(), built.end()));
+    // a stamp taken before the entries are counted still matches (as for the marker)
+    REQUIRE(ShaderWarm::ReadWarmProgress(
+                warm, *ShaderWarm::CurrentWarmStamp(warm, 0, 0x1234, 0x2206, 53, 0x77))
+                .size() == built.size());
+    // another driver, variant or file: nothing is trusted
+    REQUIRE(ShaderWarm::ReadWarmProgress(
+                warm, *ShaderWarm::CurrentWarmStamp(warm, 0, 0x1235, 0x2206, 53, 0x77))
+                .empty());
+    REQUIRE(ShaderWarm::ReadWarmProgress(
+                warm, *ShaderWarm::CurrentWarmStamp(warm, 0, 0x1234, 0x2206, 53, 0x78))
+                .empty());
+    WriteBytes(warm, "precachf");
+    REQUIRE(ShaderWarm::ReadWarmProgress(
+                warm, *ShaderWarm::CurrentWarmStamp(warm, 0, 0x1234, 0x2206, 53, 0x77))
+                .empty());
+    // a file cut short is not trusted at all
+    WriteBytes(warm, "precache");
+    WriteBytes(ShaderWarm::WarmProgressPath(warm),
+               fmt::format("v1 {} {} {} {} {} {} {} 3\n1\n2\n", stamp.size, stamp.content_hash,
+                           stamp.entries, stamp.driver, stamp.device_id, stamp.cache_version,
+                           stamp.variant));
+    REQUIRE(ShaderWarm::ReadWarmProgress(warm, stamp).empty());
+}
