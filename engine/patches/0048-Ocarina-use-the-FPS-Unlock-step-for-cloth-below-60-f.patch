From dcc2eae256443e634761212478fdb6ecab9b6855 Mon Sep 17 00:00:00 2001
From: Zortos <zortosdev@proton.me>
Date: Fri, 20 Nov 2026 15:51:03 +0100
Subject: [PATCH] Ocarina: use the FPS Unlock step for cloth below 60 fps
 (#2313)

Raise the existing cloth time-step cap from 1/60 to 4/60 in the
two FPS Unlock routines. Keep the same hook addresses and guards.
Dark's Dynamic FPS is unchanged.

Based on Frizti's adaptation of dukenheimer's Longshot PR #1384.
(cherry picked from commit f27a6903dcfccccd8c852a32ffa0141170d075ce)

Co-authored-by: Frizti <FriztiMouche@gmail.com>
Co-authored-by: capy-ai[bot] <230910855+capy-ai[bot]@users.noreply.github.com>
---
 docs/nx2/ocarina-dynamic-fps.md     | 10 +++++-----
 src/core/file_sys/patch_manager.cpp | 11 +++++------
 src/tests/core/builtin_patches.cpp  |  2 +-
 3 files changed, 11 insertions(+), 12 deletions(-)

diff --git a/docs/nx2/ocarina-dynamic-fps.md b/docs/nx2/ocarina-dynamic-fps.md
index 7e32e692b..4ea4cbc66 100644
--- a/docs/nx2/ocarina-dynamic-fps.md
+++ b/docs/nx2/ocarina-dynamic-fps.md
@@ -254,11 +254,11 @@ wind run fast (twice as fast at 120 fps). Four sites load the 1/60 constant befo
 `0x14632C` (`ldr s0`), `0x2AB804` (`fmov s0, w8`), `0x2C207A4` (`ldr s0`) and `0x2C2208C` (`ldr s2`).
 
 `FPS Unlock (built-in)` replaces each with `bl` to 48 bytes at `0x3C46B00` (result in `s0`) or
-`0x3C46B30` (in `s2`), which return `min(T+0x18, 1/60)` (`T+0x18` is step / 60), or 1/60 when the
-step is not positive. At 60 fps and below the value is the original constant bit for bit. The
-routines use only x16 and x17. Live in Kakariko, breakpoints hit `0x2C2208C` and `0x2AB804` several
-times a frame (the other two sites did not run there); at about 86 fps, restoring the original bytes
-made clothes and hair visibly sway faster, and the patch brought them back to the 60 fps pace.
+`0x3C46B30` (in `s2`), which return the game's step / 60 at `T+0x18`, capped at 4/60.
+At a step of 1 the result is the original constant bit for bit. Below 60 fps, cloth now advances
+with the rest of the game instead of lagging behind movement. This applies only with FPS Unlock;
+Dark's Dynamic FPS is unchanged. The routines use x16 and x17. The prior above-60-fps fix was
+checked in Kakariko by restoring the original bytes at about 86 fps, which sped up cloth again.
 The drifting dust fog (full-screen shader `3ddfb1d7a854c849`) needs no fix: its time, written at
 `0x478338`, already advances by wind speed / 120 times the frame step.
 
diff --git a/src/core/file_sys/patch_manager.cpp b/src/core/file_sys/patch_manager.cpp
index 5e459e83c..56a0ea5bc 100644
--- a/src/core/file_sys/patch_manager.cpp
+++ b/src/core/file_sys/patch_manager.cpp
@@ -348,9 +348,8 @@ constexpr std::array<u8, 40> SCARECROW_LAST_ROUTINE{
 };
 // The cloth update (Havok cloth: clothes, hair, and the wind action's phase) gets its time step as
 // scale * 1/60, without the frame step, at four sites. Above 60 fps every frame still simulates
-// 1/60 s, so cloth and wind run fast (twice as fast at 120 fps). Each 1/60 load becomes a call
-// that returns min(step / 60, 1/60) (1/60 when the step is not positive), so 60 fps and below
-// keep the original value exactly.
+// 1/60 s, so cloth and wind run fast at high FPS and lag behind the game at low FPS.
+// Each load now follows step / 60 up to 4/60; at step 1 the value is still exactly 1/60.
 constexpr std::array<u8, 4> CLOTH_DT_ORIGINAL_A{0x00, 0x6D, 0x46, 0xBD}; // ldr s0, [x8, #0x66c]
 constexpr std::array<u8, 4> CLOTH_DT_ORIGINAL_B{0x00, 0x01, 0x27, 0x1E}; // fmov s0, w8
 constexpr std::array<u8, 4> CLOTH_DT_ORIGINAL_D{0x02, 0x6D, 0x46, 0xBD}; // ldr s2, [x8, #0x66c]
@@ -358,15 +357,15 @@ constexpr std::array<u8, 4> CLOTH_DT_CALL_A{0xF5, 0x01, 0xEC, 0x94};     // bl m
 constexpr std::array<u8, 4> CLOTH_DT_CALL_B{0xBF, 0x6C, 0xE6, 0x94};     // bl main+0x3C46B00
 constexpr std::array<u8, 4> CLOTH_DT_CALL_C{0xD7, 0x98, 0x40, 0x94};     // bl main+0x3C46B00
 constexpr std::array<u8, 4> CLOTH_DT_CALL_D{0xA9, 0x92, 0x40, 0x94};     // bl main+0x3C46B30
-// x16 = step / 60 bits ; w17 = (bits - 1 < bits(1/60) - 1 ? bits : bits(1/60)) ; fmov s0|s2, w17
+// w17 = step / 60 bits ; select w17 when positive and within 4/60, else 4/60 ; fmov s0|s2, w17
 constexpr std::array<u8, 48> CLOTH_DT_ROUTINE_S0{
     0xD0, 0x81, 0x00, 0x90, 0x10, 0x4A, 0x44, 0xF9, 0x10, 0x02, 0x40, 0xF9, 0x11, 0x1A, 0x40, 0xB9,
-    0x10, 0x11, 0x91, 0x52, 0x10, 0x91, 0xA7, 0x72, 0x31, 0x06, 0x00, 0x51, 0x3F, 0x02, 0x10, 0x6B,
+    0x10, 0x11, 0x91, 0x52, 0x10, 0xB1, 0xA7, 0x72, 0x31, 0x06, 0x00, 0x51, 0x3F, 0x02, 0x10, 0x6B,
     0x31, 0x32, 0x90, 0x1A, 0x31, 0x06, 0x00, 0x11, 0x20, 0x02, 0x27, 0x1E, 0xC0, 0x03, 0x5F, 0xD6,
 };
 constexpr std::array<u8, 48> CLOTH_DT_ROUTINE_S2{
     0xD0, 0x81, 0x00, 0x90, 0x10, 0x4A, 0x44, 0xF9, 0x10, 0x02, 0x40, 0xF9, 0x11, 0x1A, 0x40, 0xB9,
-    0x10, 0x11, 0x91, 0x52, 0x10, 0x91, 0xA7, 0x72, 0x31, 0x06, 0x00, 0x51, 0x3F, 0x02, 0x10, 0x6B,
+    0x10, 0x11, 0x91, 0x52, 0x10, 0xB1, 0xA7, 0x72, 0x31, 0x06, 0x00, 0x51, 0x3F, 0x02, 0x10, 0x6B,
     0x31, 0x32, 0x90, 0x1A, 0x31, 0x06, 0x00, 0x11, 0x22, 0x02, 0x27, 0x1E, 0xC0, 0x03, 0x5F, 0xD6,
 };
 constexpr std::array FPS_UNLOCK_RECORDS{
