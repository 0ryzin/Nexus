From c22c108aeeb14cf5c70e1ee8e9b16f3941b4edf2 Mon Sep 17 00:00:00 2001
From: zortos293 <65777760+zortos293@users.noreply.github.com>
Date: Tue, 17 Nov 2026 07:45:39 +0000
Subject: [PATCH 36/38] video_core: scale the slope bias only when the viewport
 is rescaled

With viewport_scale_offset_enabled off, the viewport keeps the unscaled
surface clip, so the host slope per pixel is unchanged. Cache the applied scale
so the bias is recorded again when it changes without a register write.

(cherry picked from commit 22550579cd7879988586755d1c982af5930a244c)
---
 src/video_core/renderer_opengl/gl_rasterizer.cpp |  4 +++-
 src/video_core/renderer_vulkan/vk_rasterizer.cpp | 13 +++++++------
 src/video_core/renderer_vulkan/vk_rasterizer.h   |  1 +
 3 files changed, 11 insertions(+), 7 deletions(-)

diff --git a/src/video_core/renderer_opengl/gl_rasterizer.cpp b/src/video_core/renderer_opengl/gl_rasterizer.cpp
index fdcfce357..6e21fb697 100644
--- a/src/video_core/renderer_opengl/gl_rasterizer.cpp
+++ b/src/video_core/renderer_opengl/gl_rasterizer.cpp
@@ -1363,7 +1363,9 @@ void RasterizerOpenGL::SyncLineState() {
 void RasterizerOpenGL::SyncPolygonOffset() {
     auto& flags = maxwell3d->dirty.flags;
     const float slope_scale =
-        texture_cache.IsRescaling() ? Settings::values.resolution_info.up_factor : 1.0f;
+        texture_cache.IsRescaling() && maxwell3d->regs.viewport_scale_offset_enabled
+            ? Settings::values.resolution_info.up_factor
+            : 1.0f;
     if (!flags[Dirty::PolygonOffset] && slope_scale == polygon_offset_slope_scale) {
         return;
     }
diff --git a/src/video_core/renderer_vulkan/vk_rasterizer.cpp b/src/video_core/renderer_vulkan/vk_rasterizer.cpp
index 618c77ba0..d21def5d2 100644
--- a/src/video_core/renderer_vulkan/vk_rasterizer.cpp
+++ b/src/video_core/renderer_vulkan/vk_rasterizer.cpp
@@ -4519,9 +4519,14 @@ void RasterizerVulkan::UpdateScissorsState(Tegra::Engines::Maxwell3D::Regs& regs
 }
 
 void RasterizerVulkan::UpdateDepthBias(Tegra::Engines::Maxwell3D::Regs& regs) {
-    if (!state_tracker.TouchDepthBias()) {
+    // The slope term is per pixel, so a rescaled viewport needs it scaled back to guest pixels.
+    const float slope_scale = texture_cache.IsRescaling() && regs.viewport_scale_offset_enabled
+                                  ? Settings::values.resolution_info.up_factor
+                                  : 1.0f;
+    if (!state_tracker.TouchDepthBias() && slope_scale == depth_bias_slope_scale) {
         return;
     }
+    depth_bias_slope_scale = slope_scale;
     float units = regs.depth_bias / 2.0f;
     const bool is_d24 = regs.zeta.format == Tegra::DepthFormat::Z24_UNORM_S8_UINT ||
                         regs.zeta.format == Tegra::DepthFormat::X8Z24_UNORM ||
@@ -4545,11 +4550,7 @@ void RasterizerVulkan::UpdateDepthBias(Tegra::Engines::Maxwell3D::Regs& regs) {
         }
     }
     float clamp = regs.depth_bias_clamp;
-    float factor = regs.slope_scale_depth_bias;
-    if (texture_cache.IsRescaling()) {
-        // The slope term is per pixel, so a rescaled target needs it scaled back to guest pixels.
-        factor *= Settings::values.resolution_info.up_factor;
-    }
+    float factor = regs.slope_scale_depth_bias * slope_scale;
     if (far_plane_draw) {
         const bool reversed =
             regs.viewport_scale_offset_enabled && regs.viewport_transform[0].scale_z < 0.0f;
diff --git a/src/video_core/renderer_vulkan/vk_rasterizer.h b/src/video_core/renderer_vulkan/vk_rasterizer.h
index df8f93425..eae236540 100644
--- a/src/video_core/renderer_vulkan/vk_rasterizer.h
+++ b/src/video_core/renderer_vulkan/vk_rasterizer.h
@@ -551,6 +551,7 @@ private:
     /// for it: it gets a depth bias towards the far value and depth clamping (see
     /// UpdateDynamicStates).
     bool far_plane_draw{};
+    float depth_bias_slope_scale = 1.0f;
     VertexInputState recorded_vertex_input;
     bool vertex_input_recorded{};
 
-- 
