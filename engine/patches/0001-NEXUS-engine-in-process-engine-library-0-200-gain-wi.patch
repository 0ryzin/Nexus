diff --git a/.github/workflows/nexus-engine.yml b/.github/workflows/nexus-engine.yml
new file mode 100644
index 000000000..56a1bcac7
--- /dev/null
+++ b/.github/workflows/nexus-engine.yml
@@ -0,0 +1,50 @@
+# NEXUS Engine build: compiles nexus_engine.dll from this repository (the NEXUS fork of the
+# Lichii/Eden code base), runs the test suite, and only publishes a build when every test passes.
+name: nexus-engine
+
+on:
+  push:
+    branches: [nexus, "sync/**"]
+    tags: ["engine-v*"]
+  pull_request:
+  workflow_dispatch:
+
+jobs:
+  windows:
+    runs-on: windows-latest
+    timeout-minutes: 240
+    steps:
+      - uses: actions/checkout@v4
+        with:
+          fetch-depth: 0
+      - uses: ilammy/msvc-dev-cmd@v1
+        with:
+          arch: x64
+      - name: Configure
+        shell: cmd
+        run: >
+          cmake -S . -B build -G Ninja -DCMAKE_BUILD_TYPE=Release
+          -DENABLE_QT=OFF -DYUZU_CMD=OFF -DNEXUS_ENGINE=ON -DYUZU_TESTS=ON
+          -DENABLE_WEB_SERVICE=OFF -DYUZU_ROOM=OFF -DENABLE_UPDATE_CHECKER=OFF -DENABLE_WERROR=OFF
+          -DNEXUS_ENGINE_VERSION=%GITHUB_REF_NAME%
+      - name: Build
+        shell: cmd
+        run: cmake --build build --target nexus_engine tests
+      - name: Test (whole suite; the gate for publishing)
+        shell: cmd
+        run: build\bin\tests.exe
+      - name: Smoke test the C interface
+        shell: pwsh
+        run: python tools/nexus/abi_smoke.py build/bin/nexus_engine.dll
+      - name: Package
+        shell: pwsh
+        run: python tools/nexus/package_engine.py build/bin dist-engine
+      - uses: actions/upload-artifact@v4
+        with:
+          name: nexus-engine-windows-x64
+          path: dist-engine/*.zip
+      - name: Publish release (tags only, after tests passed)
+        if: startsWith(github.ref, 'refs/tags/engine-v')
+        uses: softprops/action-gh-release@v2
+        with:
+          files: dist-engine/*
