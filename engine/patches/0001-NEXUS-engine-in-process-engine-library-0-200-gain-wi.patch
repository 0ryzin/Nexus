+# SPDX-FileCopyrightText: 2026 NEXUS project
+# SPDX-License-Identifier: GPL-3.0-or-later
+
+# nexus_engine: the NEXUS emulation engine as a shared library (nexus_engine.dll) that the NEXUS
+# application loads into its own process. It reuses the upstream core libraries and the SDL3
+# game-window code of the command-line frontend; it has no executable of its own.
+
+set(NEXUS_ENGINE_VERSION "0.1.0" CACHE STRING "Version reported by nexus_engine_info")
+
+if (ENABLE_OPENGL)
+    set(NEXUS_GL_SOURCES ../yuzu_cmd/emu_window/emu_window_sdl3_gl.cpp ../yuzu_cmd/emu_window/emu_window_sdl3_gl.h)
+endif()
+
+add_library(nexus_engine SHARED
+    include/nexus_engine.h
+    nexus_engine.cpp
+    ../yuzu_cmd/emu_window/emu_window_sdl3.cpp
+    ../yuzu_cmd/emu_window/emu_window_sdl3.h
+    ../yuzu_cmd/emu_window/sdl_window_state.h
+    ../yuzu_cmd/emu_window/emu_window_sdl3_null.cpp
+    ../yuzu_cmd/emu_window/emu_window_sdl3_null.h
+    ../yuzu_cmd/emu_window/emu_window_sdl3_vk.cpp
+    ../yuzu_cmd/emu_window/emu_window_sdl3_vk.h
+    ../yuzu_cmd/sdl_config.cpp
+    ../yuzu_cmd/sdl_config.h
+    ${NEXUS_GL_SOURCES}
+)
+
+target_compile_definitions(nexus_engine PRIVATE NEXUS_ENGINE_VERSION="${NEXUS_ENGINE_VERSION}")
+target_include_directories(nexus_engine PUBLIC include PRIVATE ${CMAKE_CURRENT_SOURCE_DIR} ${CMAKE_CURRENT_BINARY_DIR}/gen)
+target_link_libraries(nexus_engine PRIVATE common core input_common frontend_common video_core network
+    nlohmann_json::nlohmann_json SDL3::SDL3 ${PLATFORM_LIBRARIES} Threads::Threads)
+if (ENABLE_OPENGL)
+    target_link_libraries(nexus_engine PRIVATE glad)
+endif()
+set_target_properties(nexus_engine PROPERTIES PREFIX "" C_VISIBILITY_PRESET hidden CXX_VISIBILITY_PRESET hidden)
+
+# Window icon: the NEXUS emblem (dist/nexus.bmp) compiled in under the name the upstream window
+# code includes ("yuzu_cmd/yuzu_icon.h").
+file(READ "${PROJECT_SOURCE_DIR}/dist/nexus.bmp" NEXUS_ICON_HEX HEX)
+string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," NEXUS_ICON_HEX "${NEXUS_ICON_HEX}")
