diff --git a/tools/nexus/abi_smoke.py b/tools/nexus/abi_smoke.py
new file mode 100644
index 000000000..dc175e420
--- /dev/null
+++ b/tools/nexus/abi_smoke.py
@@ -0,0 +1,21 @@
+"""Loads nexus_engine.dll and checks its C interface without starting a game."""
+import ctypes, json, sys
+
+dll = ctypes.CDLL(sys.argv[1])
+dll.nexus_engine_api_version.restype = ctypes.c_int32
+dll.nexus_engine_info.restype = ctypes.c_char_p
+assert dll.nexus_engine_api_version() == 1, "unexpected API version"
+info = json.loads(dll.nexus_engine_info())
+assert info["name"] == "NEXUS Engine" and info["systems"], info
+buf = ctypes.create_string_buffer(512)
+n = dll.nexus_engine_status(buf, 512)
+status = json.loads(buf.value)
+assert status["state"] == "idle", status
+assert dll.nexus_engine_start(b"{not json") == -2, "bad request must be refused"
+dll.nexus_engine_set_volume(150)
+dll.nexus_engine_status(buf, 512)
+assert json.loads(buf.value)["volume"] == 150
+dll.nexus_engine_set_volume(999)
+dll.nexus_engine_status(buf, 512)
+assert json.loads(buf.value)["volume"] == 200, "volume must clamp to 200"
+print("ABI smoke test passed:", info["version"])
diff --git a/tools/nexus/package_engine.py b/tools/nexus/package_engine.py
new file mode 100644
index 000000000..ddb421154
--- /dev/null
+++ b/tools/nexus/package_engine.py
@@ -0,0 +1,24 @@
+"""Packages nexus_engine.dll and the DLLs it needs into nexus-engine-<version>-win64.zip with an
+engine.json manifest (version, source commit, upstream base, SHA-256 of every file)."""
+import hashlib, json, os, subprocess, sys, zipfile
+
+src, out = sys.argv[1], sys.argv[2]
+os.makedirs(out, exist_ok=True)
+files = ["nexus_engine.dll"] + sorted(f for f in os.listdir(src) if f.lower().endswith(".dll") and f != "nexus_engine.dll")
+version = os.environ.get("GITHUB_REF_NAME", "dev").replace("engine-v", "")
+commit = subprocess.check_output(["git", "rev-parse", "HEAD"], text=True).strip()
+base = subprocess.run(["git", "describe", "--tags", "--match", "build-*", "--abbrev=0"], capture_output=True, text=True).stdout.strip()
+manifest = {"name": "NEXUS Engine", "version": version, "api": 1, "commit": commit, "upstreamBase": base, "files": {}}
+for f in files:
+    with open(os.path.join(src, f), "rb") as fh:
+        manifest["files"][f] = hashlib.sha256(fh.read()).hexdigest()
+zpath = os.path.join(out, f"nexus-engine-{version}-win64.zip")
+with zipfile.ZipFile(zpath, "w", zipfile.ZIP_DEFLATED) as z:
+    for f in files:
+        z.write(os.path.join(src, f), f)
+    z.writestr("engine.json", json.dumps(manifest, indent=2))
+with open(zpath, "rb") as fh:
+    digest = hashlib.sha256(fh.read()).hexdigest()
+with open(zpath + ".sha256", "w") as fh:
+    fh.write(f"{digest}  {os.path.basename(zpath)}\n")
+print(zpath, digest)
diff --git a/tools/nexus/upstream-sync.sh b/tools/nexus/upstream-sync.sh
new file mode 100755
index 000000000..63ccbdfd6
--- /dev/null
+++ b/tools/nexus/upstream-sync.sh
@@ -0,0 +1,53 @@
+#!/usr/bin/env bash
+# NEXUS Engine upstream sync.
+#
+#   tools/nexus/upstream-sync.sh report  [ref]   list what changed upstream since our last merge
+#   tools/nexus/upstream-sync.sh merge   [ref]   merge an upstream ref into a new sync/<ref> branch
+#
+# The NEXUS engine is a fork: branch "nexus" = upstream code + NEXUS changes, as normal git
+# history. Upstream improvements arrive by MERGING upstream refs (never by copying files or
+# replacing binaries), so NEXUS changes are kept and conflicts are resolved explicitly. A sync
+# branch is pushed for CI; only a branch that builds and passes every test is merged into
+# "nexus" and tagged engine-vX.Y.Z, which is what the NEXUS application can install. Every
+# earlier engine tag stays available for rollback.
+set -euo pipefail
+
+remote_setup() {
+  git remote get-url lichii >/dev/null 2>&1 || git remote add lichii https://github.com/zortos293/Lichii
+  git remote get-url eden   >/dev/null 2>&1 || git remote add eden   https://github.com/eden-emulator/mirror
+  # Ryujinx (C#/.NET, MIT) is tracked for reference only: its code cannot be linked into this C++
+  # engine; individual fixes are ported by hand with attribution (see NEXUS_ENGINE.md).
+  git remote get-url ryujinx >/dev/null 2>&1 || git remote add ryujinx https://git.ryujinx.app/ryubing/ryujinx || true
+}
+
+last_merged() { git describe --tags --match 'build-*' --abbrev=0 nexus 2>/dev/null || echo build-130; }
+
+cmd=${1:-report}
+ref=${2:-}
+remote_setup
+git fetch --tags lichii
+[ -z "$ref" ] && ref=$(git tag --list 'build-*' --sort=-v:refname | head -1)
+base=$(last_merged)
+
+case "$cmd" in
+report)
+  echo "Upstream ref: $ref   last merged: $base"
+  echo "Commits: $(git rev-list --count "$base..$ref")"
+  git log --no-merges --format='  %h %s' "$base..$ref" | head -200
+  echo
+  echo "Files touched upstream that NEXUS also changed (likely conflicts):"
+  comm -12 <(git diff --name-only "$base" "$ref" | sort) <(git diff --name-only "$base" nexus | sort) | sed 's/^/  /'
+  ;;
+merge)
+  branch="sync/${ref}"
+  git switch -c "$branch" nexus
+  if git merge --no-ff -m "sync: merge upstream $ref into NEXUS engine" "$ref"; then
+    echo "Merged cleanly into $branch. Push it; CI builds and tests it before it can reach 'nexus'."
+  else
+    echo "Conflicts to resolve (NEXUS changes must be kept, upstream fixes taken):"
+    git diff --name-only --diff-filter=U | sed 's/^/  /'
+    exit 2
+  fi
+  ;;
+*) echo "usage: $0 report|merge [ref]"; exit 1 ;;
+esac
