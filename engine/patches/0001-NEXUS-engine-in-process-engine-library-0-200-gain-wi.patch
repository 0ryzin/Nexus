+create_target_directory_groups(nexus_engine)
diff --git a/src/nexus_engine/include/nexus_engine.h b/src/nexus_engine/include/nexus_engine.h
new file mode 100644
index 000000000..3f2a2f1fa
--- /dev/null
+++ b/src/nexus_engine/include/nexus_engine.h
@@ -0,0 +1,62 @@
+// SPDX-FileCopyrightText: 2026 NEXUS project
+// SPDX-License-Identifier: GPL-3.0-or-later
+
+// NEXUS Engine: the emulation engine the NEXUS application loads into its own process
+// (nexus_engine.dll). This is the only interface between the NEXUS interface and the engine;
+// it is a plain C ABI so the host can call it without a C++ runtime of its own (NEXUS's host is
+// written in Go and loads the DLL with LoadLibrary/GetProcAddress).
+//
+// Threading: every function may be called from any thread. A game session runs on a thread the
+// engine owns; it creates the game window, drives input/audio/video and shuts the game down.
+// Strings are UTF-8; JSON is used for requests and status so the ABI never changes shape.
+
+#pragma once
+
+#include <stdint.h>
+
+#ifdef _WIN32
+#define NEXUS_API __declspec(dllexport)
+#else
+#define NEXUS_API __attribute__((visibility("default")))
+#endif
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+#define NEXUS_ENGINE_API_VERSION 1
+
+/// Version of this C interface. The host refuses engines with a different major version.
+NEXUS_API int32_t nexus_engine_api_version(void);
+
+/// Static description of the engine build as JSON:
+/// {"name","version","api","upstream":{"project","commit","describe"},"systems":[...],
+///  "renderers":[...],"components":[...]}
+NEXUS_API const char* nexus_engine_info(void);
+
+/// Starts a game session. request_json:
+/// {"game":path,"dataDir":path,"configFile":path,"logDir":path,"title":text,
+///  "fullscreen":bool,"volume":0..200,"ownerWindow":hwnd-as-number}
+/// Returns 0 when the session thread started, -1 if a session is already running, -2 for a bad
+/// request. Load errors are reported asynchronously through nexus_engine_status.
+NEXUS_API int32_t nexus_engine_start(const char* request_json);
+
+/// Writes the session status as JSON into buf (always NUL-terminated). Returns the length needed
+/// (excluding NUL); if that is >= buf_len the text was truncated.
+/// {"state":"idle|starting|running|stopping|stopped|error","frames":N,"programId":"…",
+///  "code":"…","message":"…","volume":N}
+NEXUS_API int32_t nexus_engine_status(char* buf, int32_t buf_len);
+
+/// Asks the running game to close (force != 0: do not wait for the guest). Returns immediately.
+NEXUS_API int32_t nexus_engine_stop(int32_t force);
+
+/// Sets the master volume in percent (0 = muted, 100 = reference, 200 = maximum). Takes effect on
+/// the next audio buffer of a running game and is remembered for the next session.
+NEXUS_API void nexus_engine_set_volume(int32_t percent);
+
+/// Brings the game window to the front (e.g. "Return to game").
+NEXUS_API void nexus_engine_focus(void);
+
+#ifdef __cplusplus
+}
+#endif
diff --git a/src/nexus_engine/nexus_engine.cpp b/src/nexus_engine/nexus_engine.cpp
new file mode 100644
index 000000000..9d420e8d7
--- /dev/null
+++ b/src/nexus_engine/nexus_engine.cpp
@@ -0,0 +1,435 @@
+// SPDX-FileCopyrightText: 2026 NEXUS project
+// SPDX-License-Identifier: GPL-3.0-or-later
+
+// NEXUS Engine session host. The game lifecycle mirrors the upstream command-line frontend
+// (src/yuzu_cmd/yuzu.cpp: Initialize, ApplySettings, window, content providers, Load, GPU start,
+// Run, and Pause + ShutdownMainProcess on exit) but runs inside the NEXUS process on an engine
+// thread, is driven through the C interface in nexus_engine.h and reports its state back to
+// NEXUS instead of to a console.
+
+#include <algorithm>
+#include <atomic>
+#include <chrono>
+#include <cstdio>
+#include <cstring>
+#include <filesystem>
+#include <memory>
+#include <mutex>
+#include <string>
+#include <thread>
+
+#include <SDL3/SDL.h>
+#include <nlohmann/json.hpp>
+
+#include "common/fs/fs.h"
+#include "common/fs/path_util.h"
+#include "common/logging.h"
+#include "common/scm_rev.h"
+#include "common/settings.h"
+#include "core/core.h"
+#include "core/core_timing.h"
+#include "core/cpu_manager.h"
+#include "core/file_sys/registered_cache.h"
+#include "core/file_sys/vfs/vfs_real.h"
+#include "core/hle/service/am/applet_manager.h"
+#include "core/hle/service/filesystem/filesystem.h"
+#include "core/loader/loader.h"
+#include "input_common/main.h"
+#include "network/network.h"
+#include "nexus_engine.h"
+#include "video_core/gpu.h"
+#include "video_core/rasterizer_interface.h"
+#include "video_core/renderer_base.h"
+#include "yuzu_cmd/emu_window/emu_window_sdl3.h"
+#ifdef HAS_OPENGL
+#include "yuzu_cmd/emu_window/emu_window_sdl3_gl.h"
+#endif
+#include "yuzu_cmd/emu_window/emu_window_sdl3_null.h"
+#include "yuzu_cmd/emu_window/emu_window_sdl3_vk.h"
+#include "yuzu_cmd/sdl_config.h"
+
+#ifdef _WIN32
+#include <windows.h>
+#include "common/windows/timer_resolution.h"
+#endif
+
+#ifndef NEXUS_ENGINE_VERSION
+#define NEXUS_ENGINE_VERSION "0.1.0-dev"
+#endif
+
+namespace {
+
+using json = nlohmann::json;
+
+enum class State { Idle, Starting, Running, Stopping, Stopped, Error };
+
+const char* StateName(State s) {
+    switch (s) {
+    case State::Idle: return "idle";
+    case State::Starting: return "starting";
+    case State::Running: return "running";
+    case State::Stopping: return "stopping";
+    case State::Stopped: return "stopped";
+    case State::Error: return "error";
+    }
+    return "idle";
+}
+
+struct Request {
+    std::string game;
+    std::string data_dir;
+    std::string config_file;
+    std::string title{"NEXUS"};
+    bool fullscreen{true};
+    int volume{100};
+    std::uintptr_t owner_window{};
+};
+
+struct Engine {
+    std::mutex mutex;
+    std::thread thread;
+    std::atomic<State> state{State::Idle};
+    std::atomic<bool> stop_requested{false};
+    std::atomic<bool> force_stop{false};
+    std::atomic<int> volume{100};
+    std::atomic<std::uint64_t> frames{0};
+    std::atomic<std::uint64_t> program_id{0};
+    std::string code;    // guarded by mutex
+    std::string message; // guarded by mutex
+    std::string info_json;
+    bool logging_started{false};
+    std::atomic<void*> window_handle{nullptr};
+    // Like the Qt frontend, one Core::System lives for the whole process: it is initialised once
+    // and each game is loaded into it and shut down again (Load / ShutdownMainProcess).
+    std::unique_ptr<Core::System> system;
+    std::unique_ptr<InputCommon::InputSubsystem> input;
+};
+
+Engine& E() {
+    static Engine engine;
+    return engine;
+}
+
+void Fail(const char* code, const std::string& message) {
+    {
+        std::scoped_lock lk{E().mutex};
+        E().code = code;
+        E().message = message;
+    }
+    LOG_CRITICAL(Frontend, "NEXUS Engine: {} ({})", message, code);
+    E().state = State::Error;
+}
+
+const char* LoadErrorMessage(Core::SystemResultStatus r, const char** code) {
+    switch (r) {
+    case Core::SystemResultStatus::ErrorGetLoader:
+        *code = "unsupported-file";
+        return "This file is not a game NEXUS can load.";
+    case Core::SystemResultStatus::ErrorMemoryAllocation:
+        *code = "memory";
+        return "Not enough memory to start the game. Close other applications and try again.";
+    case Core::SystemResultStatus::ErrorNotInitialized:
+        *code = "cpu";
+        return "The CPU emulator could not be initialised.";
+    case Core::SystemResultStatus::ErrorVideoCore:
+        *code = "gpu";
+        return "The graphics renderer could not be started. Update your GPU driver or switch the "
+               "graphics backend in Emulation settings.";
+    default:
+        *code = "load";
+        return "The game could not be loaded. Check that your keys and firmware are installed and "
+               "match the game.";
+    }
+}
+
+std::unique_ptr<EmuWindow_SDL3> MakeWindow(InputCommon::InputSubsystem& input, Core::System& system,
+                                           bool fullscreen) {
+    switch (Settings::values.renderer_backend.GetValue()) {
+#ifdef HAS_OPENGL
+    case Settings::RendererBackend::OpenGL_GLSL:
+    case Settings::RendererBackend::OpenGL_GLASM:
+    case Settings::RendererBackend::OpenGL_SPIRV:
+        return std::make_unique<EmuWindow_SDL3_GL>(&input, system, fullscreen);
+#endif
+    case Settings::RendererBackend::Null:
+        return std::make_unique<EmuWindow_SDL3_Null>(&input, system, fullscreen);
+    case Settings::RendererBackend::Vulkan:
+    default:
+        return std::make_unique<EmuWindow_SDL3_VK>(&input, system, fullscreen);
+    }
+}
+
+void AttachToOwner(SDL_Window* window, std::uintptr_t owner) {
+#ifdef _WIN32
+    if (window == nullptr) {
+        return;
+    }
+    const SDL_PropertiesID props = SDL_GetWindowProperties(window);
+    auto* hwnd = static_cast<HWND>(
+        SDL_GetPointerProperty(props, SDL_PROP_WINDOW_WIN32_HWND_POINTER, nullptr));
+    if (hwnd == nullptr) {
+        return;
+    }
+    E().window_handle = hwnd;
+    if (owner != 0) {
+        // Owned by the NEXUS window: it stays above NEXUS and is part of the same application.
+        SetWindowLongPtrW(hwnd, GWLP_HWNDPARENT, static_cast<LONG_PTR>(owner));
+    }
+    SetForegroundWindow(hwnd);
+#else
+    (void)window;
+    (void)owner;
+#endif
+}
+
+void RunSession(Request req) {
+    Engine& e = E();
+    e.frames = 0;
+    e.program_id = 0;
+
+    // All engine data lives in the folder NEXUS chose (keys, firmware, NAND, saves, caches).
+    Common::FS::SetAppDirectory(req.data_dir);
+    if (!e.logging_started) {
+        Common::Log::Initialize();
+        Common::Log::Start();
+        e.logging_started = true;
+    }
+    LOG_INFO(Frontend, "NEXUS Engine {} ({}-{}) starting {}", NEXUS_ENGINE_VERSION,
+             Common::g_scm_branch, Common::g_scm_desc, req.game);
+
+    // Settings come from the session config NEXUS wrote (global + per-game values).
+    SdlConfig config{req.config_file};
+    Settings::values.volume.SetValue(static_cast<u8>(std::clamp(e.volume.load(), 0, 200)));
+    WindowTitleOverride() = req.title;
+
+    const bool network = Network::Init();
+    {
+        if (!e.system) {
+            e.system = std::make_unique<Core::System>();
+            e.input = std::make_unique<InputCommon::InputSubsystem>();
+            e.system->Initialize();
+        }
+        Core::System& system = *e.system;
+        InputCommon::InputSubsystem& input = *e.input;
+        system.ApplySettings();
+
+        std::unique_ptr<EmuWindow_SDL3> window = MakeWindow(input, system, req.fullscreen);
+#ifdef _WIN32
+        Common::Windows::SetCurrentTimerResolutionToMaximum();
+        system.CoreTiming().SetTimerResolutionNs(Common::Windows::GetCurrentTimerResolution());
+#endif
+        system.SetContentProvider(std::make_unique<FileSys::ContentProviderUnion>());
+        static FileSys::ManualContentProvider manual_provider;
+        system.RegisterContentProvider(FileSys::ContentProviderUnionSlot::FrontendManual,
+                                       &manual_provider);
+        system.SetFilesystem(std::make_shared<FileSys::RealVfsFilesystem>());
+        system.GetFileSystemController().CreateFactories(*system.GetFilesystem());
+        system.GetUserChannel().clear();
+
+        Service::AM::FrontendAppletParameters params{.applet_id = Service::AM::AppletId::Application};
+        const auto result = system.Load(*window, req.game, params);
+        if (result != Core::SystemResultStatus::Success) {
+            const char* code = "load";
+            const std::string msg = LoadErrorMessage(result, &code);
+            window.reset();
+            if (network) {
+                Network::Shutdown();
+            }
+            Fail(code, msg);
+            return;
+        }
+        e.program_id = system.GetApplicationProcessProgramID();
+
+        system.GPU().Start();
+        system.GetCpuManager().OnGpuReady();
+        if (Settings::values.use_disk_shader_cache.GetValue()) {
+            system.Renderer().ReadRasterizer()->LoadDiskResources(
+                system.GetApplicationProcessProgramID(), std::stop_token{},
+                [](VideoCore::LoadCallbackStage, size_t, size_t) {});
+        }
+        system.RegisterExitCallback([] { E().stop_requested = true; }); // the game quit itself
+
+        AttachToOwner(window->GetSDLWindow(), req.owner_window);
+        const std::uint64_t presents_at_start = Core::g_nx2_present_count.load();
+        void(system.Run());
+        e.state = State::Running;
+
+        // Event loop: input, window events, live volume, stop requests.
+        int applied_volume = e.volume.load();
+        while (!e.stop_requested && window->IsOpen()) {
+            SDL_Event event;
+            if (SDL_WaitEventTimeout(&event, 4)) {
+                do {
+                    window->OnEvent(event);
+                } while (SDL_PollEvent(&event));
+            }
+            window->ApplyPendingTitle();
+            e.frames = Core::g_nx2_present_count.load() - presents_at_start;
+            if (const int v = e.volume.load(); v != applied_volume) {
+                Settings::values.volume.SetValue(static_cast<u8>(std::clamp(v, 0, 200)));
+                applied_volume = v;
+            }
+        }
+
+        e.state = State::Stopping;
+        LOG_INFO(Frontend, "NEXUS Engine: stopping (force={})", e.force_stop.load());
+        system.DetachDebugger();
+        if (system.IsPoweredOn()) {
+            void(system.Pause());
+            system.ShutdownMainProcess();
+        }
+        e.window_handle = nullptr;
+        window.reset();
+    }
+    if (network) {
+        Network::Shutdown();
+    }
+    e.state = State::Stopped;
+}
+
+std::string BuildInfo() {
+    json j = json::object();
+    j["name"] = "NEXUS Engine";
+    j["version"] = NEXUS_ENGINE_VERSION;
+    j["api"] = NEXUS_ENGINE_API_VERSION;
+    j["upstream"] = json::object();
+    j["upstream"]["project"] = "Lichii (Eden lineage)";
+    j["upstream"]["branch"] = std::string{Common::g_scm_branch};
+    j["upstream"]["describe"] = std::string{Common::g_scm_desc};
+    json sw1 = json::object();
+    sw1["id"] = "switch1";
+    sw1["name"] = "Nintendo Switch";
+    sw1["status"] = "engine core";
+    json sw2 = json::object();
+    sw2["id"] = "switch2";
+    sw2["name"] = "Nintendo Switch 2";
+    sw2["status"] = "experimental upstream code (nx2 work); untested by NEXUS";
+    j["systems"] = json::array();
+    j["systems"].push_back(sw1);
+    j["systems"].push_back(sw2);
+    j["renderers"] = json::array();
+    j["renderers"].push_back("vulkan");
+#ifdef HAS_OPENGL
+    j["renderers"].push_back("opengl");
+#endif
+    j["renderers"].push_back("null");
+    j["components"] = json::array();
+    for (const char* c : {"cpu: dynarmic JIT (ARMv8)",
+                          "gpu: Maxwell/Ampere command processing, Vulkan/OpenGL renderers",
+                          "audio: audio_core with NEXUS 0-200% gain", "input: SDL3 + input_common",
+                          "services: HLE (Horizon OS services)",
+                          "loader: NSP/XCI/NSZ/XCZ/NCA/NRO/NSO/NUP"}) {
+        j["components"].push_back(c);
+    }
+    return j.dump();
+}
+
+} // namespace
+
+extern "C" {
+
+NEXUS_API int32_t nexus_engine_api_version(void) {
+    return NEXUS_ENGINE_API_VERSION;
+}
+
+NEXUS_API const char* nexus_engine_info(void) {
+    Engine& e = E();
+    std::scoped_lock lk{e.mutex};
+    if (e.info_json.empty()) {
+        e.info_json = BuildInfo();
+    }
+    return e.info_json.c_str();
+}
+
+NEXUS_API int32_t nexus_engine_start(const char* request_json) {
+    Engine& e = E();
+    const State s = e.state.load();
+    if (s == State::Starting || s == State::Running || s == State::Stopping) {
+        return -1;
+    }
+    Request req;
+    try {
+        const json j = json::parse(request_json ? request_json : "{}");
+        req.game = j.at("game").get<std::string>();
+        req.data_dir = j.at("dataDir").get<std::string>();
+        req.config_file = j.at("configFile").get<std::string>();
+        req.title = j.value("title", std::string{"NEXUS"});
+        req.fullscreen = j.value("fullscreen", true);
+        req.volume = j.value("volume", 100);
+        req.owner_window = j.value("ownerWindow", std::uintptr_t{0});
+    } catch (const std::exception&) {
+        return -2;
+    }
+    if (e.thread.joinable()) {
+        e.thread.join();
+    }
+    {
+        std::scoped_lock lk{e.mutex};
+        e.code.clear();
+        e.message.clear();
+    }
+    e.volume = std::clamp(req.volume, 0, 200);
+    e.stop_requested = false;
+    e.force_stop = false;
+    e.state = State::Starting;
+    e.thread = std::thread([req] {
+        try {
+            RunSession(req);
+        } catch (const std::exception& ex) {
+            Fail("exception", ex.what());
+        }
+    });
+    return 0;
+}
+
+NEXUS_API int32_t nexus_engine_status(char* buf, int32_t buf_len) {
+    Engine& e = E();
+    json j = json::object();
+    j["state"] = StateName(e.state.load());
+    j["frames"] = e.frames.load();
+    j["volume"] = e.volume.load();
+    if (const auto id = e.program_id.load(); id != 0) {
+        char hex[17];
+        std::snprintf(hex, sizeof(hex), "%016llX", static_cast<unsigned long long>(id));
+        j["programId"] = hex;
+    }
+    {
+        std::scoped_lock lk{e.mutex};
+        if (!e.code.empty()) {
+            j["code"] = e.code;
+            j["message"] = e.message;
+        }
+    }
+    const std::string text = j.dump();
+    if (buf != nullptr && buf_len > 0) {
+        const auto n = std::min<std::size_t>(text.size(), static_cast<std::size_t>(buf_len - 1));
+        std::memcpy(buf, text.data(), n);
+        buf[n] = '\0';
+    }
+    return static_cast<int32_t>(text.size());
+}
+
+NEXUS_API int32_t nexus_engine_stop(int32_t force) {
+    Engine& e = E();
+    e.force_stop = force != 0;
+    e.stop_requested = true;
+    SDL_Event quit{};
+    quit.type = SDL_EVENT_QUIT;
+    SDL_PushEvent(&quit); // wakes the session's event loop
+    return 0;
+}
+
+NEXUS_API void nexus_engine_set_volume(int32_t percent) {
+    E().volume = std::clamp<int32_t>(percent, 0, 200);
+}
+
+NEXUS_API void nexus_engine_focus(void) {
+#ifdef _WIN32
+    if (void* hwnd = E().window_handle.load()) {
+        ShowWindow(static_cast<HWND>(hwnd), SW_RESTORE);
+        SetForegroundWindow(static_cast<HWND>(hwnd));
+    }
+#endif
+}
+
+} // extern "C"
