new file mode 100644
index 000000000..f0506621b
--- /dev/null
+++ b/src/audio_core/sink/nexus_gain.h
@@ -0,0 +1,50 @@
+// SPDX-FileCopyrightText: 2026 NEXUS project
+// SPDX-License-Identifier: GPL-3.0-or-later
+
+// NEXUS output gain: 0-200 % master volume.
+//
+// Upstream mapped volumes above 100 % through 0.6 + 20*log10(v), which made 101 % quieter than
+// 100 % (x0.6) and 200 % a x6.6 boost followed by hard clipping. NEXUS uses a linear gain
+// (0 % silent, 50 % half amplitude, 100 % unchanged, 200 % double) and, only when the gain is
+// above 1, a soft limiter: samples below 80 % of full scale pass unchanged, louder ones bend
+// smoothly (tanh knee) towards full scale instead of clipping. At or below 100 % the output is
+// bit-identical to upstream (plain clamp), so normal listening is unchanged.
+
+#pragma once
+
+#include <algorithm>
+#include <cmath>
+#include <cstdint>
+
+namespace AudioCore::Nexus {
+
+constexpr float kFullScale = 32767.0f;
+constexpr float kKnee = 0.80f * kFullScale;
+
+/// Maps the volume setting (percent, 0-200) to a linear gain.
+inline float GainFromPercent(float percent) {
+    return std::clamp(percent, 0.0f, 200.0f) / 100.0f;
+}
+
+/// Smoothly limits |x| to full scale; identity below the knee.
+inline float SoftLimit(float x) {
+    const float a = std::fabs(x);
+    if (a <= kKnee) {
+        return x;
+    }
+    const float range = kFullScale - kKnee;
+    const float y = kKnee + range * std::tanh((a - kKnee) / range);
+    return std::copysign(y, x);
+}
+
+/// Applies gain to one sample (in s16 units) and converts back to s16.
+inline std::int16_t ApplyGain(float sample, float gain) {
+    float x = sample * gain;
+    if (gain > 1.0f) {
+        x = SoftLimit(x);
+    }
+    const float r = std::nearbyint(std::clamp(x, -32768.0f, 32767.0f));
+    return static_cast<std::int16_t>(r);
+}
+
+} // namespace AudioCore::Nexus
