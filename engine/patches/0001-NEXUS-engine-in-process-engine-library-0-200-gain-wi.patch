+++ b/src/tests/nexus/nexus_gain.cpp
@@ -0,0 +1,38 @@
+// SPDX-FileCopyrightText: 2026 NEXUS project
+// SPDX-License-Identifier: GPL-3.0-or-later
+
+#include <cmath>
+#include <catch2/catch_test_macros.hpp>
+#include "audio_core/sink/nexus_gain.h"
+
+using namespace AudioCore::Nexus;
+
+TEST_CASE("NEXUS volume: 0, 50, 100 percent", "[nexus][audio]") {
+    REQUIRE(ApplyGain(10000.0f, GainFromPercent(0)) == 0);
+    REQUIRE(ApplyGain(10000.0f, GainFromPercent(50)) == 5000);
+    REQUIRE(ApplyGain(-10000.0f, GainFromPercent(50)) == -5000);
+    for (int s = -32768; s <= 32767; s += 97) { // 100 % is bit-identical to the input
+        REQUIRE(ApplyGain(float(s), GainFromPercent(100)) == s);
+    }
+}
+
+TEST_CASE("NEXUS volume: amplification is linear for quiet signals", "[nexus][audio]") {
+    REQUIRE(ApplyGain(8000.0f, GainFromPercent(150)) == 12000);
+    REQUIRE(ApplyGain(8000.0f, GainFromPercent(200)) == 16000);
+    REQUIRE(ApplyGain(1000.0f, GainFromPercent(101)) == 1010); // no drop just above 100 %
+}
+
+TEST_CASE("NEXUS volume: loud amplified signals never clip and stay monotonic", "[nexus][audio]") {
+    for (float gain : {1.25f, 1.5f, 2.0f}) {
+        int prev = -40000;
+        for (int s = -32768; s <= 32767; s += 13) {
+            const int y = ApplyGain(float(s), gain);
+            REQUIRE(y >= -32767);
+            REQUIRE(y <= 32767);
+            REQUIRE(y >= prev);
+            prev = y;
+        }
+    }
+    REQUIRE(ApplyGain(32767.0f, 2.0f) < 32767 + 1);
+    REQUIRE(ApplyGain(30000.0f, 2.0f) > ApplyGain(20000.0f, 2.0f));
+}
