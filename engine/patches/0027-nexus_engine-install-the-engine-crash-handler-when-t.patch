+// Starts the engine log once per process. On Windows it also installs the engine's crash handler
+// (as Lichii's own front-ends do): an unhandled exception, abort() or a CRT invalid-parameter
+// failure then logs a Critical "Host crash" line with the faulting module+offset, thread and
+// stack, flushes the log and writes eden_crash.dmp next to it. Without it a native crash inside
+// NEXUS ends the process with no trace, because the Go runtime turns off the Windows error box.
+// EDEN_NX2_CRASH_DUMP=<dir> puts the dump elsewhere, as in Lichii.
+void StartLogging(Engine& e) {
+    if (e.logging_started) {
+        return;
+    }
+    Common::Log::Initialize();
+    Common::Log::Start();
+    e.logging_started = true;
+#ifdef _WIN32
+    const char* const crash_dump_dir = std::getenv("EDEN_NX2_CRASH_DUMP");
+    Common::Windows::InstallCrashHandler(
+        crash_dump_dir ? std::filesystem::path{crash_dump_dir}
+                       : Common::FS::GetEdenPath(Common::FS::EdenPath::LogDir));
+#endif
+}
