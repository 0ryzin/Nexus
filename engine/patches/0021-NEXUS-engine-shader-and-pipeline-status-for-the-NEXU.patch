+++ b/src/video_core/nexus_shader_status.h
@@ -0,0 +1,103 @@
+// SPDX-FileCopyrightText: 2026 NEXUS project
+// SPDX-License-Identifier: GPL-3.0-or-later
+
+// Shader and pipeline status for the NEXUS performance interface: how many of the pipelines a
+// game used came ready from the disk cache, how many it had to compile while playing (the ones
+// that can stutter), and how many builds are queued or running now. Read by nexus_engine for its
+// status; NEXUS shows it on the loading screen and in the performance bar.
+//
+// The pipeline counts are StutterTrace's lookups (counted once per pipeline at its first use in a
+// session; NEXUS turns that counting on always, it is one relaxed atomic add per pipeline). Builds
+// in flight come from the pipeline cache's shader job scheduler, which registers itself here.
+// Counts are process-wide and monotonic; a session's numbers are the difference from its start
+// (Since).
+
+#pragma once
+
+#include <algorithm>
+#include <functional>
+#include <mutex>
+#include <optional>
+
+#include "common/common_types.h"
+#include "video_core/nx2_stutter_trace.h"
+#include "video_core/shader_jobs.h"
+
+namespace NexusShaderStatus {
+
+struct Counts {
+    u64 from_cache{};    ///< Pipelines built from the disk cache at boot, first used
+    u64 from_prebuild{}; ///< Built from the disk cache in the background, first used
+    u64 compiled{};      ///< Compiled when first used: not ready from the cache (can stutter)
+    u64 programs_reused{};   ///< Shader programs taken from cache records instead of translated
+    u64 programs_translated{};
+    u64 queued{};  ///< Builds waiting (all priorities)
+    u64 running{}; ///< Builds running now
+    u64 background_queued{}; ///< Cached pipelines still waiting for the background prebuild
+    u64 failed{};
+    bool builds_known{}; ///< A pipeline cache is registered (queued/running/failed are real)
+};
+
+namespace detail {
+inline std::mutex mutex;
+inline std::function<VideoCommon::ShaderJobStats()> job_stats;
+inline const void* owner{};
+} // namespace detail
+
+/// The pipeline cache's scheduler reports its jobs from now on (owner: the pipeline cache).
+inline void RegisterJobs(const void* owner, std::function<VideoCommon::ShaderJobStats()> stats) {
+    std::scoped_lock lock{detail::mutex};
+    detail::owner = owner;
+    detail::job_stats = std::move(stats);
+}
+
+/// Called by the pipeline cache before its scheduler goes away.
+inline void UnregisterJobs(const void* owner) {
+    std::scoped_lock lock{detail::mutex};
+    if (detail::owner == owner) {
+        detail::owner = nullptr;
+        detail::job_stats = nullptr;
+    }
+}
+
+[[nodiscard]] inline Counts Read() {
+    using VideoCommon::StutterTrace::Lookup;
+    const auto lookup = [](Lookup l) {
+        return VideoCommon::StutterTrace::g_totals.lookups[static_cast<size_t>(l)].load(
+            std::memory_order_relaxed);
+    };
+    Counts c;
+    c.from_cache = lookup(Lookup::GraphicsPrebuilt) + lookup(Lookup::ComputePrebuilt);
+    c.from_prebuild = lookup(Lookup::GraphicsBackground);
+    c.compiled = lookup(Lookup::GraphicsRecorded) + lookup(Lookup::GraphicsNew) +
+                 lookup(Lookup::ComputeNew);
+    c.programs_reused = lookup(Lookup::ProgramHit);
+    c.programs_translated = lookup(Lookup::ProgramMiss) + lookup(Lookup::ProgramStale);
+    std::scoped_lock lock{detail::mutex};
+    if (detail::job_stats) {
+        const auto stats = detail::job_stats();
+        for (size_t i = 0; i < VideoCommon::NumShaderJobPriorities; ++i) {
+            c.queued += stats.priorities[i].queued;
+            c.running += stats.priorities[i].running;
+            c.failed += stats.priorities[i].failed;
+        }
+        c.background_queued = stats.priorities[static_cast<size_t>(
+                                                    VideoCommon::ShaderJobPriority::Background)]
+                                  .queued;
+        c.builds_known = true;
+    }
+    return c;
+}
+
+/// The counts of one session: monotonic counts minus those at its start; builds in flight as now.
+[[nodiscard]] inline Counts Since(const Counts& start, const Counts& now) {
+    Counts c = now;
+    c.from_cache -= std::min(start.from_cache, now.from_cache);
+    c.from_prebuild -= std::min(start.from_prebuild, now.from_prebuild);
+    c.compiled -= std::min(start.compiled, now.compiled);
+    c.programs_reused -= std::min(start.programs_reused, now.programs_reused);
+    c.programs_translated -= std::min(start.programs_translated, now.programs_translated);
+    return c;
+}
+
+} // namespace NexusShaderStatus
